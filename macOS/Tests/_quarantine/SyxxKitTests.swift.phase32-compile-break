    func testParseResponsePacketDetailedRejectsCompressionLoop() {
        // The question name is skipped (not followed) via `skipName`, so the loop must be
        // planted in the *answer* name, which is resolved via the pointer-following `parseName`.
        var packet: [UInt8] = [0x12, 0x34]
        packet.append(contentsOf: [0x81, 0x80])
        packet.append(contentsOf: [0x00, 0x01]) // QDCOUNT=1
        packet.append(contentsOf: [0x00, 0x01]) // ANCOUNT=1
        packet.append(contentsOf: [0x00, 0x00, 0x00, 0x00])
        packet.append(contentsOf: encodeDNSName("example.com"))
        packet.append(contentsOf: [0x00, 0x01, 0x00, 0x01]) // question type/class

        let answerNameOffset = packet.count // the pointer below will occupy exactly this offset
        packet.append(contentsOf: [0xC0, UInt8(answerNameOffset)]) // answer name: pointer to itself
        packet.append(contentsOf: [0x00, 0x01, 0x00, 0x01]) // type/class
        packet.append(contentsOf: [0x00, 0x00, 0x00, 0x3C]) // TTL
        packet.append(contentsOf: [0x00, 0x04]) // RDLENGTH
        packet.append(contentsOf: [1, 2, 3, 4])

        let response = DNSResolver.parseResponsePacketDetailed(Data(packet), expectedTransactionID: 0x1234)
        XCTAssertEqual(response.status, .malformedResponse)
    }

    func testParseResponsePacketDetailedRejectsTransactionIDMismatch() {
        var packet: [UInt8] = [0x12, 0x34]
        packet.append(contentsOf: [0x81, 0x80])
        packet.append(contentsOf: [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00])

