<Page
    x:Class="SyxxUI.Views.PortalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
    <Grid Padding="32,18,32,32">
        <StackPanel Spacing="20">

            <!-- Header: eyebrow + ornate line + plain description (parity with macOS PortalView). -->
            <StackPanel Spacing="8">
                <TextBlock Text="PORTAL • LOCAL NETWORK &amp; ROUTE"
                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource IoBlueBrush}" />
                <TextBlock Text="A Portal carried the traveler to a distant land, tracing the path of a hidden interceptor that had reached into the stream."
                           FontFamily="{StaticResource IoFontLore}" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Portal maps local network interfaces and gateways, and traces the route to a chosen domain (syxx route) to find path anomalies, specifically highlighting where transparent proxies or middleboxes intercept queries."
                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                           Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Form input, with the ornate helper paragraph above the row (parity with macOS). -->
            <Border Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="10" Padding="14"
                    BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Of all domains, to which shall the Portal deliver you today? The Portal traces the course your traffic must follow to reach that far host. Bearing you all the way, it delivers you along the traced route in less than a blink. (A traceroute follows the packets sent from your device to the domain or IP you chose, mapping the nodes, or hops, they pass through. If traffic is being redirected, it can help reveal where. If the last hop falls short of your domain, it may have been blocked by a firewall or swept into a web proxy.)"
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                               Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBox x:Name="DomainBox" PlaceholderText="Domain (e.g., github.com)" Width="220" />
                        <Button x:Name="CheckBtn" Content="Check"
                                Click="CheckBtn_Click"
                                Background="{StaticResource IoBlueBrush}"
                                Foreground="{StaticResource IoTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Resolvers + Interfaces row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- System resolvers -->
                <Border Grid.Column="0" Background="{StaticResource IoSurfaceDarkBrush}"
                        CornerRadius="12" Padding="16" Height="110"
                        BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="RESOLVERS:"
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" />
                        <TextBlock x:Name="ResolversEmptyText" Text="No DNS servers discovered"
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                                   Foreground="{StaticResource IoTextSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <ItemsControl x:Name="ResolversList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="DNS Server"
                                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                                   Foreground="{StaticResource IoTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding}"
                                                   FontFamily="{StaticResource IoFontMono}" FontSize="14"
                                                   Foreground="{StaticResource IoTextBrush}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Active interfaces + VPN + Captive Portal + Encrypted DNS + Gateway -->
                <Border Grid.Column="2" Background="{StaticResource IoSurfaceDarkBrush}"
                        CornerRadius="12" Padding="16"
                        BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ACTIVE INTERFACES:"
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" />
                        <TextBlock x:Name="InterfacesEmptyText" Text="Run Portal to see active interfaces and VPN status."
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel x:Name="InterfacesContent" Spacing="4" Visibility="Collapsed">
                            <ItemsControl x:Name="InterfacesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                                   Foreground="{StaticResource IoTextSecondaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="VPN status:"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                           Foreground="{StaticResource IoTextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="VpnDot" Width="6" Height="6"
                                             Fill="{StaticResource IoTextSecondaryBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="VpnText" Text="No tunnel"
                                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource IoTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <!-- E150: Captive portal row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Captive portal:"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                           Foreground="{StaticResource IoTextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="CaptivePortalDot" Width="6" Height="6"
                                             Fill="{StaticResource IoTextSecondaryBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="CaptivePortalText" Text="Run Portal to check."
                                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource IoTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <!-- E150: Encrypted DNS row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Encrypted DNS:"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                           Foreground="{StaticResource IoTextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="EncryptedDnsDot" Width="6" Height="6"
                                             Fill="{StaticResource IoTextSecondaryBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="EncryptedDnsText" Text="Run Portal to check."
                                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource IoTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <!-- E150: Gateway row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Gateway:"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                           Foreground="{StaticResource IoTextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="GatewayText" Text="Run Portal to see gateway info."
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                           Foreground="{StaticResource IoTextSecondaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- LAN + Route row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LAN discovery -->
                <Border Grid.Column="0" Background="{StaticResource IoSurfaceDarkBrush}"
                        CornerRadius="12" Padding="16"
                        BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <TextBlock Text="DEVICES ON NETWORK SEGMENT:"
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" />
                        <TextBlock Text="LAN device discovery is not yet available in the GUI. Run `syxx lan` from Terminal to enumerate devices on your network segment."
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Traceroute -->
                <Border Grid.Column="2" Background="{StaticResource IoSurfaceDarkBrush}"
                        CornerRadius="12" Padding="16"
                        BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ROUTE TO CHOSEN DOMAIN:"
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" />
<!-- Grid, not a horizontal StackPanel: a StackPanel measures text at unbounded
                             width, so this line clipped at the card edge instead of wrapping. -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing Grid.Column="0" x:Name="TraceProgress" IsActive="False" Width="18" Height="18"
                                          Visibility="Collapsed" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="TraceStatusText"
                                       Text="Run Portal to trace the route to your chosen domain."
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                                       Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl x:Name="TraceHopsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{StaticResource IoFontMono}" FontSize="12"
                                               Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TraceNoteText" Text=""
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
