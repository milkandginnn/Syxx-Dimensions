<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:SyxxUI.Avalonia.Controls"
             x:Class="SyxxUI.Avalonia.Views.CageView">
  <StackPanel Spacing="20">
    <ctl:ModuleHeader x:Name="Header" Rune="&#x16BE;" Eyebrow="THE WARDEN &#x00B7; LIVE QUERY CAPTURE" Name="Cage"
                       AccentBrush="{StaticResource SyxTealBrush}" />

    <!-- Honest state: live capture needs root + raw sockets. The GUI does not fake a capture; it
         points the user at the elevated CLI, exactly as the macOS and Windows clients do. Graphical
         elevation (pkexec) is the Linux capture path (G17), still to be wired. -->
    <Border CornerRadius="12" Padding="18" Background="{StaticResource SyxSurfaceDarkBrush}"
            BorderBrush="{StaticResource SyxOrangeBrush}" BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="LIVE CAPTURE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SyxOrangeBrush}" />
        <TextBlock Text="Live packet capture needs elevated privileges and raw sockets, which this window does not hold. Run the command below in a terminal, then browse and use your apps as normal so DNS queries are produced. A capture on its own is not a security conclusion."
                   FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource SyxTextBrush}" />
        <Border Background="{StaticResource SyxCanvasBrush}" CornerRadius="6" Padding="12">
          <TextBlock Text="sudo syxx cage --duration 30" FontFamily="monospace" FontSize="14"
                     Foreground="{StaticResource SyxTealBrush}" />
        </Border>
        <TextBlock Text="Graphical elevation (pkexec) for one-click capture on Linux is planned but not yet wired."
                   FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SyxTextSecondaryBrush}" />
      </StackPanel>
    </Border>

    <!-- D282: capture results viewer placeholder. When the Cage CLI output is wired into the GUI
         (via pkexec elevation or manual capture file browse), this area will render the captured
         DNS queries with headers and answers. Until then, it shows the honest "no capture loaded"
         state rather than an empty panel that reads as broken. -->
    <Border x:Name="CaptureResultsPanel" CornerRadius="12" Padding="18"
            Background="{StaticResource SyxSurfaceDarkBrush}"
            BorderBrush="{StaticResource SyxBorderBrush}" BorderThickness="1"
            IsVisible="False">
      <StackPanel Spacing="8">
        <TextBlock Text="CAPTURED QUERIES" FontSize="12" FontWeight="Bold"
                   Foreground="{StaticResource SyxTealBrush}" />
        <TextBlock x:Name="CaptureStatusText"
                   Text="No capture loaded. Run a capture above to see DNS queries here."
                   FontSize="14" TextWrapping="Wrap"
                   Foreground="{StaticResource SyxTextSecondaryBrush}" />
        <!-- Future: ItemsRepeater bound to captured DNS query rows (query, type, answer, TTL) -->
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
