<UserControl
    x:Class="SyxxUI.Mirror.MirrorDegradationBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="BadgeBorder" CornerRadius="8" Padding="14,10,14,10" BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="10">

            <!-- Score circle: ring showing percentage fill -->
            <Grid Width="40" Height="40">
                <!-- Background ring -->
                <Ellipse x:Name="BgRing" StrokeThickness="3" />
                <!-- Foreground arc (simulated with a TextBlock showing percentage) -->
                <TextBlock x:Name="PercentageText"
                           FontFamily="{StaticResource IoFontMonoBold}" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Label column -->
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="DEGRADATION"
                           FontFamily="{StaticResource IoFontMonoBold}" FontSize="9"
                           Foreground="{DynamicResource IoTextFaintBrush}"
                           CharacterSpacing="150" />
                <TextBlock x:Name="ClassificationText"
                           FontFamily="{StaticResource IoFontMonoBold}" FontSize="13" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
