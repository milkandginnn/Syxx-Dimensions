<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SyxxUI.Avalonia.Views.MirrorDiffView">

  <Border Background="#FF1e1e2e" CornerRadius="8" BorderBrush="{StaticResource SyxBorderSubtleBrush}" BorderThickness="1">
    <DockPanel>

      <!-- Section tabs header -->
      <Border DockPanel.Dock="Top" Background="#FF2d2d3d"
              BorderBrush="{StaticResource SyxBorderSubtleBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <!-- Summary on the right -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12"
                      Margin="0,0,14,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="+" Foreground="{StaticResource SyxTealBrush}"
                         FontFamily="{StaticResource SyxMonoFont}" FontSize="11" FontWeight="Bold" />
              <TextBlock x:Name="AdditionsCount" Text="0" Foreground="{StaticResource SyxTealBrush}"
                         FontFamily="{StaticResource SyxMonoFont}" FontSize="11" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="−" Foreground="{StaticResource SyxRedBrush}"
                         FontFamily="{StaticResource SyxMonoFont}" FontSize="11" FontWeight="Bold" />
              <TextBlock x:Name="RemovalsCount" Text="0" Foreground="{StaticResource SyxRedBrush}"
                         FontFamily="{StaticResource SyxMonoFont}" FontSize="11" />
            </StackPanel>
          </StackPanel>

          <!-- Section toggle buttons -->
          <StackPanel x:Name="SectionTabs" Orientation="Horizontal" Spacing="0">
            <Button x:Name="HtmlTab" Click="OnHtmlTabClick" Classes="SectionTab">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="HtmlChevron" Text="▸" FontSize="9" Foreground="{StaticResource SyxTextMutedBrush}" />
                <TextBlock Text="HTML" FontFamily="{StaticResource SyxMonoFont}" FontSize="11" FontWeight="Medium"
                           Foreground="{StaticResource SyxTextMutedBrush}" />
                <TextBlock x:Name="HtmlChangeCount" FontFamily="{StaticResource SyxMonoFont}" FontSize="10"
                           Foreground="{StaticResource SyxRedBrush}" IsVisible="False" />
              </StackPanel>
            </Button>
            <Button x:Name="CssTab" Click="OnCssTabClick" Classes="SectionTab">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="CssChevron" Text="▸" FontSize="9" Foreground="{StaticResource SyxTextMutedBrush}" />
                <TextBlock Text="CSS" FontFamily="{StaticResource SyxMonoFont}" FontSize="11" FontWeight="Medium"
                           Foreground="{StaticResource SyxTextMutedBrush}" />
                <TextBlock x:Name="CssChangeCount" FontFamily="{StaticResource SyxMonoFont}" FontSize="10"
                           Foreground="{StaticResource SyxRedBrush}" IsVisible="False" />
              </StackPanel>
            </Button>
            <Button x:Name="JsTab" Click="OnJsTabClick" Classes="SectionTab">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="JsChevron" Text="▸" FontSize="9" Foreground="{StaticResource SyxTextMutedBrush}" />
                <TextBlock Text="JavaScript" FontFamily="{StaticResource SyxMonoFont}" FontSize="11" FontWeight="Medium"
                           Foreground="{StaticResource SyxTextMutedBrush}" />
                <TextBlock x:Name="JsChangeCount" FontFamily="{StaticResource SyxMonoFont}" FontSize="10"
                           Foreground="{StaticResource SyxRedBrush}" IsVisible="False" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Diff content -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DiffContent" Margin="12" Spacing="0" />
      </ScrollViewer>

    </DockPanel>
  </Border>

  <UserControl.Styles>
    <Style Selector="Button.SectionTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>
</UserControl>
