    // F007 — DomainCanonical A-label length guard (post-IDNA, not pre-IDNA UTF-8).
    func testDomainCanonical_rejectsNameTooLongAfterEncoding() throws {
        // Craft a name whose UTF-8 is ≤ 253 but whose A-label form exceeds 253 bytes.
        // Each non-ASCII label "aä" encodes to "xn--a-uua" (9 chars) vs 3 UTF-8 bytes.
        // 28 labels × 9 chars + 27 dots = 252+27 = 279 > 253; UTF-8 = 28×3+27 = 111 ≤ 253.
        let label = "aä"   // 3 UTF-8 bytes → "xn--a-uua" (9 ASCII bytes) after IDNA
        let name = Array(repeating: label, count: 28).joined(separator: ".")
        XCTAssertThrowsError(try DomainCanonical.canonicalize(name),
            "A name whose A-label form exceeds 253 bytes must be rejected")
    }

    func testDomainCanonical_acceptsNameBelowLimitAfterEncoding() throws {
        // A plain ASCII name under 253 bytes must succeed.
        // Mutation: if the length guard were still on UTF-8, this would still pass — but
        // testDomainCanonical_rejectsNameTooLongAfterEncoding would fail, proving the guard moved.
        let name = Array(repeating: "aa", count: 40).joined(separator: ".")  // 80+39=119 chars
        let result = try DomainCanonical.canonicalize(name)
        XCTAssertFalse(result.isEmpty)
    }

