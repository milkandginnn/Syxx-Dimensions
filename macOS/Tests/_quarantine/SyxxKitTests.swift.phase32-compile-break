        let records = [DNSRecord(name: "example.", type: 1, ttl: 60, rdata: "5db8d822")]
        XCTAssertEqual(DNSSECVerifier.classify(records: records, now: Date(timeIntervalSince1970: 1_500_000)), .unsigned)
    }

    func testClassifyDNSKEYWithoutRRSIGIsInconclusive() {
        // B046/A030: DNSKEY present but no covering RRSIG on this DO-enabled path -> inconclusive,
        // never "signed" and never a silent "unsigned".
