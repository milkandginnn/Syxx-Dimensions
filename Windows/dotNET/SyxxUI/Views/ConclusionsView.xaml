<Page
    x:Class="SyxxUI.Views.ConclusionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource IoBgBrush}">

    <Grid Padding="{StaticResource IoPaddingView}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">

                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="DIAGNOSTICS &#x2022; SYNTHESIS"
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource IoBlueBrush}" />
                    <TextBlock Text="Conclusions"
                               FontFamily="{StaticResource IoFontDisplay}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource IoTextBrush}" />
                    <TextBlock Text="Offline synthesis engine unifies network probes to render a security conclusion."
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                               Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Result (shown after synthesis) -->
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Spacing="16">

                    <!-- A3 report card — the glanceable grade + top three reasons. An unmeasurable
                         run renders "—" (Ungraded), never a letter. Copy PROPOSED. -->
                    <Border x:Name="ReportCardBorder" Visibility="Collapsed"
                            Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="16"
                            BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <!-- Grid, not a horizontal StackPanel: a StackPanel measures text at
                                 unbounded width, so the headline clipped instead of wrapping. -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="GradeLetterText" MinWidth="58"
                                           FontFamily="{StaticResource IoFontMono}" FontSize="44" FontWeight="Bold"
                                           Foreground="{StaticResource IoTextBrush}" />
                                <TextBlock Grid.Column="1" x:Name="GradeHeadlineText" VerticalAlignment="Center"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="18" FontWeight="Medium"
                                           Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                            </Grid>
                            <StackPanel x:Name="GradeReasonsPanel" Spacing="4" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ResultText"
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />

                    <!-- A1 "so what" card — plain meaning + the one action that matters. Populated
                         from ResultActions.For(conclusion); honesty-gated in the Kit so an
                         inconclusive/unfinished conclusion never reads as safe. Copy PROPOSED. -->
                    <Border x:Name="ActionCard" Visibility="Collapsed"
                            Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="16"
                            BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="WHAT THIS MEANS"
                                        FontFamily="{StaticResource IoFontUI}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource IoBlueBrush}" CharacterSpacing="120" />
                            <TextBlock x:Name="ActionMeaningText"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                                       Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="DO THIS"
                                        FontFamily="{StaticResource IoFontUI}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource IoBlueBrush}" CharacterSpacing="120"
                                       Margin="0,4,0,0" />
                            <TextBlock x:Name="ActionStepText"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                                       Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- A2 "why we think so" card — plain-language over the DST synthesis.
                         Populated from PlainExplanations.For(conclusion).Narrative; honesty-gated in
                         the Kit (unfinished never reads clean). Copy PROPOSED. -->
                    <Border x:Name="ExplanationCard" Visibility="Collapsed"
                            Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="16"
                            BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="WHY WE BELIEVE THIS"
                                        FontFamily="{StaticResource IoFontUI}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource IoBlueBrush}" CharacterSpacing="120" />
                            <TextBlock x:Name="ExplanationText"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                                       Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Engine reasoning surface. Populated programmatically from Conclusion.Determination
                         (the matrix DeterminativeResult); a null determination fails closed to an
                         "unavailable / not a clean result" note — never a fabricated clean preview.
                         Previously fed by the DST-era Conclusion.Stage5 / Stage5DisplayModel, both
                         retired to archive/ by the matrix cutover. -->
                    <Border x:Name="Stage5Card" Visibility="Collapsed"
                            Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="16"
                            BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="REASONING"
                                        FontFamily="{StaticResource IoFontUI}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource IoBlueBrush}" CharacterSpacing="120" />
                            <StackPanel x:Name="Stage5Body" Spacing="12" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="ResetBtn" Content="Reset Diagnosis"
                            Click="ResetBtn_Click"
                            Background="Transparent"
                            BorderBrush="{StaticResource IoBorderSubtleBrush}"
                            Foreground="{StaticResource IoTextBrush}" />
                </StackPanel>

                <!-- Component data cards (shown before synthesis) -->
                <StackPanel x:Name="EvidencePanel" Spacing="18">

                    <!-- A4/D-1 first-run scan card — one tap, zero configuration (macOS parity;
                         copy identical to macOS firstRunCard). Orchestration is Kit-level
                         FirstRunScan.RunAsync, the same engine the CLI `syxx` guided scan uses. -->
                    <Border Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="10" Padding="16"
                            BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Run a full scan"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource IoTextBrush}" />
                            <TextBlock Text="One tap runs every check that needs no setup and grades the result. No configuration required."
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                                       Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                            <Button x:Name="ScanBtn" Content="Scan my network"
                                    Click="ScanBtn_Click"
                                    Background="{StaticResource IoBlueBrush}"
                                    Foreground="{StaticResource IoTextBrush}" />
                            <Grid x:Name="ScanProgressRow" ColumnSpacing="10" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing Grid.Column="0" x:Name="ScanProgressRing" IsActive="False"
                                              Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="ScanProgressText" Text="Scanning…"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                           Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Collected Evidence"
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource IoTextBrush}" />
                    <TextBlock Text="Results from each check appear here as they complete. Run checks in the sidebar to collect evidence, then compile a unified conclusion."
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                               Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />

                    <!-- Prophet -->
                    <Border x:Name="ProphetCard" Visibility="Collapsed"
                            Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="1. PROPHET"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource IoAccentStartBrush}" />
                            <TextBlock Text="DNS Resolution &amp; Protocol Integrity"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                       Foreground="{StaticResource IoTextSecondaryBrush}" />
                            <TextBlock x:Name="ProphetDetail"
                                       FontFamily="{StaticResource IoFontMono}" FontSize="12"
                                       Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Mirror Comparison -->
                    <Border x:Name="MirrorCard" Visibility="Collapsed"
                            Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="2. MIRROR"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource IoAccentStartBrush}" />
                            <TextBlock Text="Tampering &amp; Censorship Detection"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                       Foreground="{StaticResource IoTextSecondaryBrush}" />
                            <TextBlock x:Name="MirrorDetail"
                                       FontFamily="{StaticResource IoFontMono}" FontSize="12"
                                       Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Mirror Warp -->
                    <Border x:Name="WarpCard" Visibility="Collapsed"
                            Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="2. MIRROR &#x2014; Content Warp"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource IoAccentStartBrush}" />
                            <TextBlock Text="Static Content Integrity"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                       Foreground="{StaticResource IoTextSecondaryBrush}" />
                            <TextBlock x:Name="WarpDetail"
                                       FontFamily="{StaticResource IoFontMono}" FontSize="12"
                                       Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Portal -->
                    <Border x:Name="PortalCard" Visibility="Collapsed"
                            Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="3. PORTAL"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource IoAccentStartBrush}" />
                            <TextBlock Text="Network &amp; Path Diagnostics"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                       Foreground="{StaticResource IoTextSecondaryBrush}" />
                            <TextBlock x:Name="PortalDetail"
                                       FontFamily="{StaticResource IoFontMono}" FontSize="12"
                                       Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Glutton -->
                    <Border x:Name="GluttonCard" Visibility="Collapsed"
                            Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="4. GLUTTON"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource IoAccentStartBrush}" />
                            <TextBlock Text="Privacy Leak Detection"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                       Foreground="{StaticResource IoTextSecondaryBrush}" />
                            <TextBlock x:Name="GluttonDetail"
                                       FontFamily="{StaticResource IoFontMono}" FontSize="12"
                                       Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Cage -->
                    <Border x:Name="CageCard" Visibility="Collapsed"
                            Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="5. CAGE"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource IoAccentStartBrush}" />
                            <TextBlock Text="Capture, Forensics &amp; Attribution"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                       Foreground="{StaticResource IoTextSecondaryBrush}" />
                            <TextBlock x:Name="CageDetail"
                                       FontFamily="{StaticResource IoFontMono}" FontSize="12"
                                       Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Witness -->
                    <Border x:Name="WitnessCard" Visibility="Collapsed"
                            Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="6. WITNESS"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource IoAccentStartBrush}" />
                            <TextBlock Text="Trust Infrastructure &amp; Signatures"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                       Foreground="{StaticResource IoTextSecondaryBrush}" />
                            <TextBlock x:Name="WitnessDetail"
                                       FontFamily="{StaticResource IoFontMono}" FontSize="12"
                                       Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="No checks have been run yet. Use the sidebar tools to collect evidence."
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                               Foreground="{StaticResource IoTextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,20,0,0" />
                </StackPanel>

                <!-- Synthesis button -->
                <Button x:Name="SynthesizeBtn" Content="Generate Result"
                        Click="SynthesizeBtn_Click"
                        Background="{StaticResource IoBlueBrush}"
                        Foreground="{StaticResource IoTextBrush}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
