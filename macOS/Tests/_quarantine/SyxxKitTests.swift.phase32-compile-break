    func testMakeQueryPacketRandomizesTransactionID() throws {
        // A single "id1 != id2" check passes for a SEQUENTIAL COUNTER — the exact off-path
        // spoofing / cache-poisoning weakness TXID randomization exists to prevent. Sample many IDs
        // and require both high distinctness (not fixed/near-constant) AND the absence of monotonic
        // (+1) stepping (not a predictable counter).
        var ids: [UInt16] = []
        for _ in 0..<200 {
            let (_, id) = try DNSResolver.makeQueryPacketWithID(name: "example.com", type: 1)
            ids.append(id)
        }
        XCTAssertGreaterThan(Set(ids).count, 190,
            "TXIDs must be well-distributed across 65536 values, not fixed/near-constant")
        var stepPlusOne = 0
        for i in 1..<ids.count where ids[i] == ids[i - 1] &+ 1 { stepPlusOne += 1 }
        XCTAssertLessThan(stepPlusOne, ids.count / 4,
            "TXIDs must not increment monotonically — a sequential counter is spoofable")
    }

