    // MARK: - WitnessSigner (Ed25519)

    private func makeComparison(domain: String = "example.com", redirected: Bool = false) -> SyxxKit.ComparisonResult {
        let record = DNSRecord(name: domain, type: 1, ttl: 60, rdata: "93.184.216.34")
        return SyxxKit.ComparisonResult(
            localServer: "1.1.1.1",
            localRecords: [record],
            publicResolverResults: ["Cloudflare": [record]],
            isRedirectionDetected: redirected
        )
    }

    private var testKeyPair: (privateKey: String, publicKey: String) {
        WitnessSigner.generateKeyPair()
    }

    func testWitnessSnapshotVerifiesWithCorrectKey() throws {
        let (priv, pub) = testKeyPair
        let comparison = makeComparison()
        let snapshot = try WitnessSigner.createSignedSnapshot(domain: "example.com", comparison: comparison, privateKeyBase64: priv)
        XCTAssertEqual(try WitnessSigner.verifySnapshot(snapshot), .valid)
        XCTAssertEqual(snapshot.publicKey, pub)
        XCTAssertFalse(snapshot.keyId.isEmpty)
    }

    func testWitnessSnapshotRejectsTamperedComparison() throws {
        let (priv, _) = testKeyPair
        let comparison = makeComparison(redirected: false)
        let snapshot = try WitnessSigner.createSignedSnapshot(domain: "example.com", comparison: comparison, privateKeyBase64: priv)

        // Simulate an attacker flipping the redirection result after signing.
        let tamperedComparison = makeComparison(redirected: true)
        let tamperedSnapshot = WitnessSnapshot(
            formatVersion: 2,
            timestamp: snapshot.timestamp,
            expiresAt: nil,
            targetDomain: snapshot.targetDomain,
            comparison: tamperedComparison,
            evidence: snapshot.evidence,
            signature: snapshot.signature,
            publicKey: snapshot.publicKey,
            keyId: snapshot.keyId
        )
        XCTAssertEqual(try WitnessSigner.verifySnapshot(tamperedSnapshot), .displayMismatch)
    }

    func testWitnessSnapshotRejectsTamperedDomain() throws {
        let (priv, _) = testKeyPair
        let comparison = makeComparison()
        let snapshot = try WitnessSigner.createSignedSnapshot(domain: "example.com", comparison: comparison, privateKeyBase64: priv)

        let tamperedSnapshot = WitnessSnapshot(
            formatVersion: 2,
            timestamp: snapshot.timestamp,
            expiresAt: nil,
            targetDomain: "attacker-controlled.com",
            comparison: snapshot.comparison,
            evidence: snapshot.evidence,
            signature: snapshot.signature,
            publicKey: snapshot.publicKey,
            keyId: snapshot.keyId
        )
        XCTAssertEqual(try WitnessSigner.verifySnapshot(tamperedSnapshot), .displayMismatch)
    }

    /// [B037] The display-integrity guard must also cover per-resolver outcomes. A tampered display
    /// that keeps the aggregate result/answer-sets identical (here: an extra injected resolver whose
    /// answer matches, so `comparisonResult` is unchanged) but alters `resolverQueryOutcomes` must be
    /// rejected — otherwise a forged per-resolver display verifies as authentic.
    func testWitnessSnapshotRejectsTamperedResolverOutcomes() throws {
        let (priv, _) = testKeyPair
        let snapshot = try WitnessSigner.createSignedSnapshot(domain: "example.com", comparison: makeComparison(), privateKeyBase64: priv)
        let record = DNSRecord(name: "example.com", type: 1, ttl: 60, rdata: "93.184.216.34")
        // Same result + same answer sets (Evil resolver returns the same rdata) → comparisonResult
        // is IDENTICAL, but resolverQueryOutcomes gains an entry.
        let tamperedComparison = SyxxKit.ComparisonResult(
            localServer: "1.1.1.1",
            localRecords: [record],
            publicResolverResults: ["Cloudflare": [record], "EvilInjectedResolver": [record]],
            isRedirectionDetected: false)
        let tamperedSnapshot = WitnessSnapshot(
            formatVersion: snapshot.formatVersion, timestamp: snapshot.timestamp, expiresAt: nil,
            targetDomain: snapshot.targetDomain, comparison: tamperedComparison,
            evidence: snapshot.evidence, signature: snapshot.signature,
            publicKey: snapshot.publicKey, keyId: snapshot.keyId)
        XCTAssertEqual(try WitnessSigner.verifySnapshot(tamperedSnapshot), .displayMismatch,
            "a tampered displayed resolver set must not verify, even when the result is unchanged")
    }

    /// The tamper tests above keep the signature valid and mutate a DISPLAY field, so they are
    /// caught by the display-integrity guard BEFORE the cryptographic check ever runs. This pins the
    /// cryptographic check itself: a corrupted signature over otherwise-valid evidence must fail.
    func testWitnessSnapshotRejectsCorruptedSignature() throws {
        let (priv, _) = testKeyPair
        let comparison = makeComparison()
        let snapshot = try WitnessSigner.createSignedSnapshot(domain: "example.com", comparison: comparison, privateKeyBase64: priv)
        var sigBytes = Data(base64Encoded: snapshot.signature)!
        sigBytes[0] ^= 0xFF   // flip one byte; evidence / domain / comparison all remain valid
        let corrupted = WitnessSnapshot(
            formatVersion: snapshot.formatVersion,
            timestamp: snapshot.timestamp,
            expiresAt: nil,
            targetDomain: snapshot.targetDomain,
            comparison: snapshot.comparison,
            evidence: snapshot.evidence,
            signature: sigBytes.base64EncodedString(),
            publicKey: snapshot.publicKey,
            keyId: snapshot.keyId
        )
        XCTAssertEqual(try WitnessSigner.verifySnapshot(corrupted), .invalidSignature,
            "a corrupted Ed25519 signature must fail cryptographic verification")
    }

