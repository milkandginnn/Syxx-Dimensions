// MARK: - D003 local TLS server helper

import Security

/// A throwaway HTTPS server (self-signed EC leaf) for exercising the real TLS handshake in
/// ``SyxxKitTests/testCollectorPinMismatchFailsClosedAgainstLiveTLS``. Uses `openssl s_server`
/// so no third-party dependency is needed. Purely a test fixture.
final class LocalTLSServer {
    let port: Int
    private let process: Process
    private let tempDir: URL

    private init(port: Int, process: Process, tempDir: URL) {
        self.port = port
        self.process = process
        self.tempDir = tempDir
    }

    static func start() throws -> LocalTLSServer {
        let openssl = "/opt/homebrew/bin/openssl"
        guard FileManager.default.isExecutableFile(atPath: openssl) else {
            throw NSError(domain: "LocalTLSServer", code: 1)
        }
        let dir = FileManager.default.temporaryDirectory
            .appendingPathComponent("syxx-d003-\(UUID().uuidString)")
        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
        let key = dir.appendingPathComponent("k.pem").path
        let crt = dir.appendingPathComponent("c.pem").path

        func run(_ args: [String]) throws {
            let p = Process()
            p.executableURL = URL(fileURLWithPath: openssl)
            p.arguments = args
            p.standardError = FileHandle.nullDevice
            p.standardOutput = FileHandle.nullDevice
            try p.run(); p.waitUntilExit()
        }
        try run(["req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1",
                 "-nodes", "-keyout", key, "-out", crt, "-days", "1", "-subj", "/CN=127.0.0.1"])

        let port = Self.freePort()
        let server = Process()
        server.executableURL = URL(fileURLWithPath: openssl)
        server.arguments = ["s_server", "-accept", "\(port)", "-cert", crt, "-key", key,
                            "-quiet", "-naccept", "20", "-www"]
        server.standardError = FileHandle.nullDevice
        server.standardOutput = FileHandle.nullDevice
        try server.run()

        // Wait for the listener to accept connections.
        for _ in 0..<50 {
            if Self.canConnect(port: port) { break }
            Thread.sleep(forTimeInterval: 0.1)
        }
        return LocalTLSServer(port: port, process: server, tempDir: dir)
    }

    func stop() {
        process.terminate()
        try? FileManager.default.removeItem(at: tempDir)
    }

    private static func freePort() -> Int {
        let fd = socket(AF_INET, SOCK_STREAM, 0)
        var addr = sockaddr_in()
        addr.sin_family = sa_family_t(AF_INET)
        addr.sin_addr.s_addr = inet_addr("127.0.0.1")
        addr.sin_port = 0
        _ = withUnsafePointer(to: &addr) {
            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) {
                bind(fd, $0, socklen_t(MemoryLayout<sockaddr_in>.size))
            }
        }
        var len = socklen_t(MemoryLayout<sockaddr_in>.size)
        _ = withUnsafeMutablePointer(to: &addr) {
            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) {
                getsockname(fd, $0, &len)
            }
        }
        let port = Int(UInt16(bigEndian: addr.sin_port))
        close(fd)
        return port
    }

    private static func canConnect(port: Int) -> Bool {
        let fd = socket(AF_INET, SOCK_STREAM, 0)
        defer { close(fd) }
        var addr = sockaddr_in()
        addr.sin_family = sa_family_t(AF_INET)
        addr.sin_addr.s_addr = inet_addr("127.0.0.1")
        addr.sin_port = UInt16(port).bigEndian
        let r = withUnsafePointer(to: &addr) {
            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) {
                connect(fd, $0, socklen_t(MemoryLayout<sockaddr_in>.size))
            }
        }
        return r == 0
    }
}

// MARK: - D011: Trust-set key membership

import CryptoKit

extension SyxxKitTests {
    // D011 trust-set membership. These previously asserted `Set.contains` on a literal the test had
    // just inserted — a test of Swift's stdlib, not of SyxxKit — while the real decision in
    // runCollectorTest had NO coverage. Inverting it, or dropping the !isEmpty guard, would report
    // an untrusted signer's attestation as TRUSTED with a green suite. Now they call the real
    // LeakDetector.checkTrustSet (twin of Windows LeakDetector.CheckTrustSet).

    func testCheckTrustSet_keyInSet_isTrusted() {
        let trustSet: Set<String> = ["pubkey-A", "pubkey-B"]
        XCTAssertEqual(LeakDetector.checkTrustSet(publicKey: "pubkey-A", trustedPublicKeys: trustSet), true,
                       "a key present in the trust set must be trusted")
    }

    func testCheckTrustSet_keyNotInSet_isUntrusted() {
        let trustSet: Set<String> = ["pubkey-B"]
        XCTAssertEqual(LeakDetector.checkTrustSet(publicKey: "pubkey-A", trustedPublicKeys: trustSet), false,
                       "a key NOT in the trust set must be untrusted — never nil, which reads as 'not checked'")
    }

    func testCheckTrustSet_noTrustSetConfigured_isNil_notFalse() {
        // The tri-state that matters: "no trust set configured" is NOT "untrusted". Collapsing nil
        // into false would report every signer as untrusted the moment the set is unconfigured.
        XCTAssertNil(LeakDetector.checkTrustSet(publicKey: "pubkey-A", trustedPublicKeys: nil))
        XCTAssertNil(LeakDetector.checkTrustSet(publicKey: "pubkey-A", trustedPublicKeys: []))
        XCTAssertNil(LeakDetector.checkTrustSet(publicKey: nil, trustedPublicKeys: ["pubkey-A"]))
    }

    func testSignatureKeyTrusted_defaultIsNil() {
        let r = LeakTestResult(result: .inconclusive)
        XCTAssertNil(r.signatureKeyTrusted,
                     "signatureKeyTrusted must be nil by default (no trust set configured)")
    }

    func testSignatureKeyTrusted_roundTrips() {
        let r = LeakTestResult(result: .inconclusive, signatureKeyTrusted: true)
        XCTAssertEqual(r.signatureKeyTrusted, true)
        let r2 = LeakTestResult(result: .inconclusive, signatureKeyTrusted: false)
        XCTAssertEqual(r2.signatureKeyTrusted, false)
    }

    func testVerify_acceptsAGenuineSignature_andTrustIsADistinctQuestion() throws {
        // verify() answers "is this signature mathematically valid"; checkTrustSet answers "do we
        // trust the signer". A genuine signature from an UNTRUSTED key must be valid AND untrusted —
        // conflating the two is how a forged-provenance attestation reads as trustworthy.
        let privateKey = Curve25519.Signing.PrivateKey()
        let pubB64 = privateKey.publicKey.rawRepresentation.base64EncodedString()
        let payload = Data("D011-test-payload".utf8)
        let sigB64 = try privateKey.signature(for: payload).base64EncodedString()

        let result = LeakTestResult(result: .notDetected, signature: sigB64,
                                    publicKey: pubB64, signedPayload: payload.base64EncodedString())

        XCTAssertTrue(LeakDetector.verify(result), "verify() must accept a genuine signature")
        XCTAssertEqual(LeakDetector.checkTrustSet(publicKey: pubB64, trustedPublicKeys: ["someone-else"]), false,
                       "a genuine signature from a key outside the trust set is VALID but UNTRUSTED")
        XCTAssertEqual(LeakDetector.checkTrustSet(publicKey: pubB64, trustedPublicKeys: [pubB64]), true)
    }
}

// MARK: - Collector HTTP status is a distinct state (DIAG-glutton-2026-07-29)

/// A throwaway plaintext HTTP/1.1 server that answers each request path with a caller-chosen
/// status and body. Exists so the leak-test status branches are exercised through the REAL
/// URLSession → HTTP response → classification path, not through a stubbed classifier. Purely a
/// test fixture; loopback only.
final class LocalStatusHTTPServer: @unchecked Sendable {
    let port: Int
    private let listenFD: Int32
    private let respond: @Sendable (String) -> (status: Int, body: String)
    private var running = true

    private init(port: Int, listenFD: Int32,
                 respond: @escaping @Sendable (String) -> (status: Int, body: String)) {
        self.port = port
        self.listenFD = listenFD
        self.respond = respond
    }

    static func start(respond: @escaping @Sendable (String) -> (status: Int, body: String)) throws
        -> LocalStatusHTTPServer {
        let fd = socket(AF_INET, SOCK_STREAM, 0)
        guard fd >= 0 else { throw NSError(domain: "LocalStatusHTTPServer", code: 1) }
        var one: Int32 = 1
        setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, socklen_t(MemoryLayout<Int32>.size))
        var addr = sockaddr_in()
        addr.sin_family = sa_family_t(AF_INET)
        addr.sin_addr.s_addr = inet_addr("127.0.0.1")
        addr.sin_port = 0
        let bound = withUnsafePointer(to: &addr) {
            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) {
                bind(fd, $0, socklen_t(MemoryLayout<sockaddr_in>.size))
            }
        }
        guard bound == 0 else { close(fd); throw NSError(domain: "LocalStatusHTTPServer", code: 2) }
        var len = socklen_t(MemoryLayout<sockaddr_in>.size)
        _ = withUnsafeMutablePointer(to: &addr) {
            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) { getsockname(fd, $0, &len) }
        }
        guard listen(fd, 16) == 0 else { close(fd); throw NSError(domain: "LocalStatusHTTPServer", code: 3) }
        let server = LocalStatusHTTPServer(port: Int(UInt16(bigEndian: addr.sin_port)),
                                           listenFD: fd, respond: respond)
        Thread.detachNewThread { server.acceptLoop() }
        return server
    }

    private func acceptLoop() {
        while running {
            let client = accept(listenFD, nil, nil)
            if client < 0 { return }
            handle(client)
            close(client)
        }
    }

    private func handle(_ client: Int32) {
        // Read the request head. Content-Length is 0 on every route this fixture serves, so the
        // blank line that ends the headers ends the request.
        var request = ""
        var buffer = [UInt8](repeating: 0, count: 2048)
        while !request.contains("\r\n\r\n") {
            let n = read(client, &buffer, buffer.count)
            if n <= 0 { break }
            request += String(decoding: buffer[0..<n], as: UTF8.self)
        }
        let path = request.split(separator: " ").dropFirst().first.map(String.init) ?? "/"
        let (status, body) = respond(path)
        let head = """
        HTTP/1.1 \(status) Status\r
        Content-Type: application/json\r
        Content-Length: \(body.utf8.count)\r
        Connection: close\r
        \r

        """
        let out = Array((head + body).utf8)
        _ = out.withUnsafeBufferPointer { write(client, $0.baseAddress, $0.count) }
    }

    func stop() {
        running = false
        close(listenFD)
    }
}

extension SyxxKitTests {

    // Every string the client can put on screen for a collector failure. A user-facing reason that
    // matches any of these is the Foundation NSError bridge template leaking through, which is what
    // shipped: "The operation couldn't be completed. (SyxxKit.LeakDetector.(unknown context at
    // $100fbc78c).CollectorError error 0.)". Mirrors SyxxApp's ErrorPresenter.isBoilerplate, which
    // lives in another module and cannot be imported here.
    private func assertNotBridgeDump(_ s: String, _ message: String,
                                     file: StaticString = #filePath, line: UInt = #line) {
        XCTAssertFalse(s.contains("operation couldn't be completed"), message, file: file, line: line)
        XCTAssertFalse(s.contains("operation couldn\u{2019}t be completed"), message, file: file, line: line)
        XCTAssertFalse(s.contains("unknown context at"), message, file: file, line: line)
        XCTAssertNil(s.range(of: "\\$[0-9a-fA-F]{4,}", options: .regularExpression),
                     message, file: file, line: line)
        XCTAssertNil(s.range(of: "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+ error -?[0-9]+",
                             options: .regularExpression),
                     message, file: file, line: line)
    }

    /// The core of the defect: 402 (paywall), 401/403 (auth), 429 (rate limit) and 5xx (collector
    /// down) are DIFFERENT answers and must not classify alike. Before the fix every one of them
    /// produced a single indistinguishable `.error`.
    func testCollectorStatusClassificationKeepsDistinctStatesDistinct() {
        XCTAssertEqual(LeakDetector.classifyStatus(402), .entitlementRequired(status: 402))
        XCTAssertEqual(LeakDetector.classifyStatus(401), .authenticationFailed(status: 401))
        XCTAssertEqual(LeakDetector.classifyStatus(403), .authenticationFailed(status: 403))
        XCTAssertEqual(LeakDetector.classifyStatus(429), .rateLimited(status: 429))
        XCTAssertEqual(LeakDetector.classifyStatus(500), .serverError(status: 500))
        XCTAssertEqual(LeakDetector.classifyStatus(503), .serverError(status: 503))
        XCTAssertEqual(LeakDetector.classifyStatus(599), .serverError(status: 599))

        // Adversarial / unrecognised: the status is preserved verbatim and NO cause is asserted.
        // A collector (or an on-path proxy pretending to be one) can return anything at all.
        XCTAssertEqual(LeakDetector.classifyStatus(404), .unexpectedStatus(404))
        XCTAssertEqual(LeakDetector.classifyStatus(418), .unexpectedStatus(418))
        XCTAssertEqual(LeakDetector.classifyStatus(302), .unexpectedStatus(302))
        XCTAssertEqual(LeakDetector.classifyStatus(600), .unexpectedStatus(600))
        XCTAssertEqual(LeakDetector.classifyStatus(0), .unexpectedStatus(0))

        // No two of these may be equal, or the collapse is back.
        let all: [CollectorFailure] = [
            LeakDetector.classifyStatus(402), LeakDetector.classifyStatus(403),
            LeakDetector.classifyStatus(429), LeakDetector.classifyStatus(503),
            LeakDetector.classifyStatus(418)
        ]
        for i in all.indices {
            for j in all.indices where j > i {
                XCTAssertNotEqual(all[i], all[j],
                                  "distinct collector states collapsed into one: \(all[i])")
            }
        }
    }

    /// The status must survive to the caller. The old `badStatus(Int)` captured it and threw it
    /// away at the catch boundary; nothing in macOS/Sources ever read it.
    func testCollectorFailurePreservesTheHTTPStatus() {
        XCTAssertEqual(LeakDetector.classifyStatus(402).httpStatus, 402)
        XCTAssertEqual(LeakDetector.classifyStatus(429).httpStatus, 429)
        XCTAssertEqual(LeakDetector.classifyStatus(418).httpStatus, 418)
        XCTAssertEqual(LeakDetector.classifyStatus(507).httpStatus, 507)
        // No status exists for these, so none is invented.
        XCTAssertNil(CollectorFailure.transportFailure.httpStatus)
        XCTAssertNil(CollectorFailure.malformedResponse.httpStatus)
        XCTAssertNil(CollectorFailure.collectorIdentityUnverified.httpStatus)

        XCTAssertTrue(LeakDetector.classifyStatus(402).requiresEntitlement)
        for other in [403, 429, 500, 418] {
            XCTAssertFalse(LeakDetector.classifyStatus(other).requiresEntitlement,
                           "HTTP \(other) is not a paywall and must not offer an upgrade path")
        }
    }

    /// No collector failure may ever resolve to a clean result. Absence of observation is not
    /// evidence of absence: a 402 means the test never ran, not that DNS is fine.
    func testCollectorFailureNeverResolvesToACleanResult() {
        let every: [CollectorFailure] = [
            .entitlementRequired(status: 402), .authenticationFailed(status: 403),
            .rateLimited(status: 429), .serverError(status: 500), .unexpectedStatus(418),
            .malformedResponse, .collectorIdentityUnverified, .transportFailure
        ]
        for failure in every {
            let result = LeakDetector.result(for: failure)
            XCTAssertNotEqual(result, .notDetected,
                              "\(failure) must never read as 'no leak detected'")
            XCTAssertNotEqual(result, .confirmed,
                              "\(failure) attests no resolver and cannot confirm a leak")
        }
        // A paywall is a correct answer from a correct server, not a broken product.
        XCTAssertEqual(LeakDetector.result(for: .entitlementRequired(status: 402)), .inconclusive,
                       "HTTP 402 is the intended paywall; rendering it as an execution error tells "
                       + "the user their product is faulty when it is not")
        XCTAssertEqual(LeakDetector.result(for: .serverError(status: 500)), .error)
        XCTAssertEqual(LeakDetector.result(for: .transportFailure), .error)
    }

    /// `CollectorError` must conform to `LocalizedError`. Without it `localizedDescription` is the
    /// Foundation bridge template, which is exactly what reached a user's screen.
    func testCollectorErrorNeverRendersAsAFoundationBridgeDump() {
        let statusError: Error = LeakDetector.CollectorError.badStatus(402)
        assertNotBridgeDump(statusError.localizedDescription,
                            "CollectorError.badStatus rendered as an NSError bridge dump")
        XCTAssertTrue(statusError.localizedDescription.contains("402"),
                      "the message must state the status it actually got: "
                      + statusError.localizedDescription)

        for other: Error in [LeakDetector.CollectorError.badJSON(URLError(.badServerResponse)),
                             LeakDetector.CollectorError.notHTTP] {
            assertNotBridgeDump(other.localizedDescription, "\(other) rendered as a bridge dump")
            XCTAssertFalse(other.localizedDescription.isEmpty)
        }
    }

    /// Classification of a thrown error. The transport-identity check must win: a pin/PKI refusal
    /// downgraded to a generic "could not be reached" would hide an on-path impostor.
    func testCollectorErrorClassificationPrefersIdentityFailure() {
        XCTAssertEqual(LeakDetector.classify(URLError(.cancelled)), .collectorIdentityUnverified)
        XCTAssertEqual(LeakDetector.classify(URLError(.timedOut)), .transportFailure)
        XCTAssertEqual(LeakDetector.classify(URLError(.notConnectedToInternet)), .transportFailure)
        XCTAssertEqual(LeakDetector.classify(LeakDetector.CollectorError.badStatus(402)),
                       .entitlementRequired(status: 402))
        XCTAssertEqual(LeakDetector.classify(LeakDetector.CollectorError.badStatus(429)),
                       .rateLimited(status: 429))
        XCTAssertEqual(LeakDetector.classify(LeakDetector.CollectorError.notHTTP), .malformedResponse)
        XCTAssertEqual(LeakDetector.classify(LeakDetector.CollectorError.badJSON(URLError(.cannotParseResponse))),
                       .malformedResponse)
    }

    /// The reason a user reads must name a real cause or a real status, never boilerplate, and must
    /// always close the honesty gap: no evidence was gathered.
    func testCollectorFailureReasonIsHonestCopy() {
        for step: CollectorStep in [.token, .verify] {
            let unrecognised = CollectorFailure.unexpectedStatus(418).reason(step: step)
            assertNotBridgeDump(unrecognised, "unexpectedStatus reason is boilerplate: \(unrecognised)")
            XCTAssertTrue(unrecognised.contains("418"),
                          "an unrecognised status must be reported verbatim, not guessed at: \(unrecognised)")

            for failure: CollectorFailure in [.entitlementRequired(status: 402),
                                              .authenticationFailed(status: 403),
                                              .rateLimited(status: 429),
                                              .serverError(status: 500),
                                              .unexpectedStatus(418),
                                              .malformedResponse, .transportFailure] {
                let reason = failure.reason(step: step)
                assertNotBridgeDump(reason, "\(failure) reason is boilerplate: \(reason)")
                XCTAssertTrue(reason.contains("nothing is known about your DNS resolvers"),
                              "\(failure) must state that no evidence exists, or it can be read as "
                              + "a clean result: \(reason)")
            }
        }
        // The two steps are not interchangeable: at `.token` no query was ever sent; at `.verify`
        // the queries WERE sent and only their result is missing. Saying "no test was performed"
        // after dispatching real queries would be false.
        let token = CollectorFailure.serverError(status: 500).reason(step: .token)
        let verify = CollectorFailure.serverError(status: 500).reason(step: .verify)
        XCTAssertNotEqual(token, verify)
        XCTAssertTrue(token.contains("No leak test was performed"), token)
        XCTAssertTrue(verify.contains("test queries were sent"), verify)

        // The pin-failure reason is owner-approved copy (2026-07-11) and must pass through intact.
        XCTAssertEqual(CollectorFailure.collectorIdentityUnverified.reason(step: .token),
                       CollectorPinning.pinFailureReason)
    }

    // MARK: Real HTTP runs through the full pipeline

    private func runAgainstLocalCollector(
        tokenStatus: Int, tokenBody: String = "", verifyStatus: Int = 200,
        servers: [String] = ["127.0.0.1"]
    ) async throws -> LeakTestResult {
        let server = try LocalStatusHTTPServer.start { path in
            if path.hasPrefix("/api/leak/token") { return (tokenStatus, tokenBody) }
            return (verifyStatus, "")
        }
        defer { server.stop() }
        return await LeakDetector.runCollectorTest(
            servers: servers,
            collectorBaseURL: URL(string: "http://127.0.0.1:\(server.port)")!,
            pollDelay: .milliseconds(1))
    }

    /// REAL RUN, token step: a live HTTP 402 from a local collector, through URLSession, must
    /// surface as an entitlement gate. This is the exact server behaviour verified against the
    /// production collector (`POST https://syxx.app/api/leak/token` returns 402 unlicensed).
    func testLive402SurfacesAsEntitlementRequiredNotAnOpaqueError() async throws {
        let result = try await runAgainstLocalCollector(tokenStatus: 402)

        XCTAssertEqual(result.collectorFailure, .entitlementRequired(status: 402))
        XCTAssertEqual(result.collectorFailure?.httpStatus, 402)
        XCTAssertTrue(result.collectorFailure?.requiresEntitlement == true)
        XCTAssertEqual(result.result, .inconclusive,
                       "a working paywall must not render as a failure of the product")
        XCTAssertNotEqual(result.result, .notDetected)
        XCTAssertTrue(result.observedResolvers.isEmpty)
        XCTAssertNil(result.signature)
        let reason = try XCTUnwrap(result.errorReason)
        assertNotBridgeDump(reason, "the 402 reason is still a bridge dump: \(reason)")
        XCTAssertTrue(reason.contains("Syxx Pro"), reason)
    }

    /// REAL RUN: rate limit, server error and an unrecognised status must reach the caller as three
    /// different things. Before the fix all three were one `.error` with one identical string.
    func testLiveNon200StatusesDoNotCollapseIntoOneState() async throws {
        let rateLimited = try await runAgainstLocalCollector(tokenStatus: 429)
        let serverDown  = try await runAgainstLocalCollector(tokenStatus: 503)
        let teapot      = try await runAgainstLocalCollector(tokenStatus: 418)
        let paywall     = try await runAgainstLocalCollector(tokenStatus: 402)
        let forbidden   = try await runAgainstLocalCollector(tokenStatus: 403)

        XCTAssertEqual(rateLimited.collectorFailure, .rateLimited(status: 429))
        XCTAssertEqual(serverDown.collectorFailure, .serverError(status: 503))
        XCTAssertEqual(teapot.collectorFailure, .unexpectedStatus(418))
        XCTAssertEqual(forbidden.collectorFailure, .authenticationFailed(status: 403))

        let reasons = [rateLimited, serverDown, teapot, paywall, forbidden].map { $0.errorReason ?? "" }
        XCTAssertEqual(Set(reasons).count, reasons.count,
                       "distinct collector states produced identical user-facing text: \(reasons)")
        // The unrecognised status names itself and guesses nothing.
        XCTAssertTrue(try XCTUnwrap(teapot.errorReason).contains("418"))
        // None of these is a paywall, so none may offer an upgrade path.
        for r in [rateLimited, serverDown, teapot, forbidden] {
            XCTAssertFalse(r.collectorFailure?.requiresEntitlement == true)
            XCTAssertEqual(r.result, .error)
            XCTAssertNotEqual(r.result, .notDetected)
        }
    }

    /// REAL RUN: a 200 with an undecodable body is NOT a status failure and must not be reported as
    /// one. It is also not a clean result.
    func testLiveMalformedTokenBodyIsDistinctFromAStatusFailure() async throws {
        let result = try await runAgainstLocalCollector(tokenStatus: 200, tokenBody: "not json at all")
        XCTAssertEqual(result.collectorFailure, .malformedResponse)
        XCTAssertNil(result.collectorFailure?.httpStatus, "no status failure occurred; 200 was returned")
        XCTAssertEqual(result.result, .error)
        XCTAssertNotEqual(result.result, .notDetected)
        assertNotBridgeDump(try XCTUnwrap(result.errorReason), "malformed-body reason is boilerplate")
    }

    /// REAL RUN, verify step: `verifyToken` had the identical collapse. A 402 on verify — after the
    /// DNS queries have really been dispatched — must classify the same way AND say so differently,
    /// because queries WERE sent. Skips (never silently passes) when no resolver is reachable.
    func testLiveVerifyStepStatusIsDistinguishedToo() async throws {
        let resolvers = NetworkKeyState.getSystemDNSServers()
        try XCTSkipIf(resolvers.isEmpty, "No system DNS resolvers; the verify step is unreachable.")
        let tokenBody = #"{"token":"t-verify-step","subdomain":"id-verifystep.leak.syxx.app"}"#
        let result = try await runAgainstLocalCollector(
            tokenStatus: 200, tokenBody: tokenBody, verifyStatus: 402, servers: resolvers)
        try XCTSkipIf(result.collectorFailure == nil && result.result == .error,
                      "Every DNS dispatch failed, so the run never reached the verify step.")

        XCTAssertEqual(result.collectorFailure, .entitlementRequired(status: 402))
        XCTAssertEqual(result.result, .inconclusive)
        XCTAssertNotEqual(result.result, .notDetected)
        let reason = try XCTUnwrap(result.errorReason)
        assertNotBridgeDump(reason, "the verify-step reason is still a bridge dump: \(reason)")
        XCTAssertTrue(reason.contains("test queries were sent"),
                      "the verify step dispatched real queries and must not claim no test ran: \(reason)")
    }

    /// REAL RUN, forged attestation: a collector (or an on-path impostor) that returns a
    /// well-formed verify body whose Ed25519 signature does NOT verify over its signed payload
    /// must resolve to .inconclusive, never to .notDetected. Before the sigValid gate, the
    /// forged no-leak payload flowed straight into reconcileResult and rendered as a clean
    /// green result. Skips (never silently passes) when no resolver is reachable, matching
    /// testLiveVerifyStepStatusIsDistinguishedToo.
    func testLiveForgedAttestationSignatureIsInconclusiveNeverClean() async throws {
        let resolvers = NetworkKeyState.getSystemDNSServers()
        try XCTSkipIf(resolvers.isEmpty, "No system DNS resolvers; the verify step is unreachable.")

        // A structurally valid attestation whose signature was made over DIFFERENT bytes than
        // the payload the response carries, so verify() must return false. This is exactly the
        // shape of a relay that swaps the payload while keeping a real signature.
        let privateKey = Curve25519.Signing.PrivateKey()
        let pubB64 = privateKey.publicKey.rawRepresentation.base64EncodedString()
        let payloadB64 = Data(#"{"leaked": false, "observedResolvers": []}"#.utf8)
            .base64EncodedString()
        let sigB64 = try privateKey.signature(for: Data("entirely different bytes".utf8))
            .base64EncodedString()

        let tokenBody = #"{"token":"t-forged-sig","subdomain":"id-forgedsig.leak.syxx.app"}"#
        let verifyBody = "{\"leaked\": false, \"observedResolvers\": [], "
            + "\"signature\": \"\(sigB64)\", \"publicKey\": \"\(pubB64)\", "
            + "\"keyId\": \"k-forged\", \"signedPayload\": \"\(payloadB64)\"}"
        let server = try LocalStatusHTTPServer.start { path in
            if path.hasPrefix("/api/leak/token") { return (200, tokenBody) }
            return (200, verifyBody)
        }
        defer { server.stop() }

        let result = await LeakDetector.runCollectorTest(
            servers: resolvers,
            collectorBaseURL: URL(string: "http://127.0.0.1:\(server.port)")!,
            pollDelay: .milliseconds(1))
        try XCTSkipIf(result.result == .error && result.errorReason?.contains("dispatch") == true,
                      "Every DNS dispatch failed, so the run never reached the verify step.")

        XCTAssertEqual(result.signatureValid, false,
                       "the tampered signature must fail verification, or this test proves nothing")
        XCTAssertNotEqual(result.result, .notDetected,
                          "a FORGED attestation must never read as a clean no-leak result")
        XCTAssertEqual(result.result, .inconclusive)
        XCTAssertEqual(result.errorReason,
                       "Collector attestation signature is invalid; result cannot be trusted.")
    }
