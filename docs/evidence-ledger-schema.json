{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Syxx Evidence Ledger Entry",
  "type": "object",
  "required": ["ledgerId","timestamp","source","evidenceType","sections","scores","signature"],
  "additionalProperties": false,
  "properties": {
    "ledgerId": { "type": "string", "description": "UUID v4 ledger entry id" },
    "timestamp": { "type": "string", "format": "date-time", "description": "ISO8601 UTC canonical timestamp (example - do not finalize without signoff)" },
    "source": { "type": "string", "description": "Originating component (Prophet|Mirror|Portal|Glutton|Cage|Witness)" },
    "evidenceType": { "type": "string", "description": "One of: probe-run, collector-leak, report, forensics-snapshot" },
    "runId": { "type": "string", "description": "Optional run identifier tying multiple entries" },
    "sections": {
      "type": "object",
      "description": "Per-component outputs (canonical ordering required)",
      "propertyNames": { "pattern": "^(Prophet|Mirror|Portal|Glutton|Cage|Witness)$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "verdict": { "type": "string", "enum": ["secure","tampered","inconclusive"], "description": "tri-state result (verdicts are not final until synthesizer aggregation)" },
          "evidenceId": { "type": "string" },
          "raw": { "type": ["object","string"], "description": "Raw probe payload (minimized)" },
          "metadata": { "type": "object" }
        },
        "required": ["verdict","evidenceId"],
        "additionalProperties": true
      }
    },
    "scores": {
      "type": "object",
      "description": "Flagship scores: resolverProvenance, tamperFingerprint, evidenceConfidence",
      "properties": {
        "resolverProvenance": { "type": ["number","null"], "minimum": 0.0, "maximum": 1.0 },
        "tamperFingerprint": { "type": ["number","null"], "minimum": 0.0, "maximum": 1.0 },
        "evidenceConfidence": { "type": ["number","null"], "minimum": 0.0, "maximum": 1.0 },
        "notes": { "type": "string" }
      },
      "required": ["evidenceConfidence"],
      "additionalProperties": true
    },
    "synthesis": {
      "type": "object",
      "properties": {
        "overallVerdict": { "type": "string", "enum":["secure","tampered","inconclusive"] },
        "decisionTreeId": { "type": "string" }
      },
      "required": ["overallVerdict"]
    },
    "signature": {
      "type": "object",
      "properties": {
        "method": { "type": "string", "enum": ["ed25519","hmac-sha256"] },
        "pubkeyId": { "type": "string" },
        "signature": { "type": "string" }
      },
      "required": ["method","signature"]
    },
    "canonicalization": {
      "type": "object",
      "description": "Deterministic serialization hints (ordering, timestamp canonicalization)",
      "properties": {
        "fieldOrder": { "type": "array", "items": { "type":"string" }, "example": ["ledgerId","timestamp","source","evidenceType","runId","sections","scores","synthesis","signature"] },
        "timestampFormat": { "type": "string", "example": "RFC3339Nano UTC" }
      }
    }
  }
}
