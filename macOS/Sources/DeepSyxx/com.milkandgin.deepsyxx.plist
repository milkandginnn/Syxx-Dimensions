<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.milkandgin.deepsyxx</string>
    
    <key>MachServices</key>
    <dict>
        <key>com.milkandgin.deepsyxx</key>
        <true/>
    </dict>
    
    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/com.milkandgin.deepsyxx</string>
    </array>
    
    <key>RunAtLoad</key>
    <false/>
    
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- D363: prevent launchd from respawning the helper in a tight crash loop.
         Without this, a helper that crashes on startup (e.g. corrupted code signature)
         is respawned immediately and repeatedly, flooding syslog and burning CPU.
         10 seconds gives time for diagnostics and avoids launchd's own rate-limit
         backoff kicking in (which disables the job for 10 minutes). -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardErrorPath</key>
    <string>/var/log/com.milkandgin.deepsyxx.err</string>
</dict>
</plist>