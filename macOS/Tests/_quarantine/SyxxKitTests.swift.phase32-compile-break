@testable import SyxxKit

final class SyxxKitTests: XCTestCase {

    // MARK: - DNSCapture packet fixtures (P3)

    private func encodeDNSName(_ domain: String) -> [UInt8] {
        var bytes: [UInt8] = []
        for label in domain.split(separator: ".") {
            bytes.append(UInt8(label.utf8.count))
            bytes.append(contentsOf: Array(label.utf8))
        }
        bytes.append(0)
        return bytes
    }

    private func makeIPv4Header(ihlWords: UInt8, protocolNumber: UInt8, srcIP: [UInt8], dstIP: [UInt8], optionsBytes: Int) -> [UInt8] {
        var header: [UInt8] = []
        header.append((4 << 4) | ihlWords) // version 4, IHL in 32-bit words
        header.append(0x00) // TOS
        header.append(contentsOf: [0x00, 0x30]) // total length (unchecked by parser)
        header.append(contentsOf: [0x00, 0x00]) // identification
        header.append(contentsOf: [0x00, 0x00]) // flags/fragment offset
        header.append(64) // TTL
        header.append(protocolNumber)
        header.append(contentsOf: [0x00, 0x00]) // header checksum (unchecked)
        header.append(contentsOf: srcIP)
        header.append(contentsOf: dstIP)
        header.append(contentsOf: [UInt8](repeating: 0, count: optionsBytes)) // IP options padding
        return header
    }

    private func makeUDPHeader(srcPort: UInt16, dstPort: UInt16, payloadLength: Int) -> [UInt8] {
        let len = 8 + payloadLength
        return [
            UInt8(srcPort >> 8), UInt8(srcPort & 0xff),
            UInt8(dstPort >> 8), UInt8(dstPort & 0xff),
            UInt8(len >> 8), UInt8(len & 0xff),
            0x00, 0x00
        ]
    }

    func testParseIPUDPHeaderIPv4StandardHeader() {
        let ip = makeIPv4Header(ihlWords: 5, protocolNumber: 17, srcIP: [10, 0, 0, 1], dstIP: [8, 8, 8, 8], optionsBytes: 0)
        let udp = makeUDPHeader(srcPort: 54321, dstPort: 53, payloadLength: 12)
        let data = Data(ip + udp + [UInt8](repeating: 0, count: 12)) // 12 bytes of "DNS payload"

        let result = DNSCapture.parseIPUDPHeader(data)
        XCTAssertNotNil(result)
        XCTAssertEqual(result?.context.ipVersion, 4)
        XCTAssertEqual(result?.context.sourceIP, "10.0.0.1")
        XCTAssertEqual(result?.context.destIP, "8.8.8.8")
        XCTAssertEqual(result?.context.sourcePort, 54321)
        XCTAssertEqual(result?.context.destPort, 53)
        XCTAssertEqual(result?.payloadOffset, 20 + 8) // standard 20-byte IPv4 header + 8-byte UDP header
        XCTAssertEqual(result?.dnsPayloadLength, 12) // C024/C029: validated payload length from UDP header
    }

    func testParseIPUDPHeaderIPv4WithOptionsAdjustsPayloadOffset() {
        // IHL=6 means a 24-byte header (20 base + 4 bytes of options) — the old fixed-20-byte
        // assumption would misread the UDP header and DNS payload location on packets like this.
        let ip = makeIPv4Header(ihlWords: 6, protocolNumber: 17, srcIP: [192, 168, 1, 1], dstIP: [1, 1, 1, 1], optionsBytes: 4)
        let udp = makeUDPHeader(srcPort: 53, dstPort: 55000, payloadLength: 12)
        let data = Data(ip + udp + [UInt8](repeating: 0, count: 12))

        let result = DNSCapture.parseIPUDPHeader(data)
        XCTAssertNotNil(result)
        XCTAssertEqual(result?.context.sourceIP, "192.168.1.1")
        XCTAssertEqual(result?.context.sourcePort, 53)
        XCTAssertEqual(result?.context.destPort, 55000)
        XCTAssertEqual(result?.payloadOffset, 24 + 8) // 24-byte IPv4 header (with options) + 8-byte UDP header
    }

    func testParseIPUDPHeaderIPv6() {
        var ip: [UInt8] = []
        ip.append(contentsOf: [0x60, 0x00, 0x00, 0x00]) // version 6, traffic class, flow label
        ip.append(contentsOf: [0x00, 0x14]) // payload length (8 bytes UDP + 12 bytes payload = 20 = 0x14)
        ip.append(17) // next header = UDP
        ip.append(64) // hop limit
        ip.append(contentsOf: [UInt8](repeating: 0, count: 15) + [1]) // source ::1 (16 bytes)
        ip.append(contentsOf: [0x26, 0x01, 0x48, 0x60, 0x48, 0x60] + [UInt8](repeating: 0, count: 8) + [0x88, 0x88]) // dest 2601:4860:4860::8888 (16 bytes)
        let udp = makeUDPHeader(srcPort: 60000, dstPort: 53, payloadLength: 12)
        let data = Data(ip + udp + [UInt8](repeating: 0, count: 12))

        let result = DNSCapture.parseIPUDPHeader(data)
        XCTAssertNotNil(result)
        XCTAssertEqual(result?.context.ipVersion, 6)
        XCTAssertEqual(result?.context.sourcePort, 60000)
        XCTAssertEqual(result?.context.destPort, 53)
        XCTAssertEqual(result?.payloadOffset, 40 + 8)
        XCTAssertEqual(result?.dnsPayloadLength, 12) // C022: validated UDP length on IPv6 path
    }

    /// C021: IPv4 fragments (MF=1 or fragment offset>0) must be rejected.
    func testParseIPUDPHeaderRejectsIPv4Fragments() {
        let ip = makeIPv4Header(ihlWords: 5, protocolNumber: 17, srcIP: [10, 0, 0, 1], dstIP: [8, 8, 8, 8], optionsBytes: 0)
        let udp = makeUDPHeader(srcPort: 54321, dstPort: 53, payloadLength: 12)
        var data = Data(ip + udp + [UInt8](repeating: 0, count: 12))
        // Set MF flag (bit 5 of flags/fragment-offset field at bytes 6-7)
        let ihl = 20
        data[data.startIndex + 6] = 0x20  // MF=1
        XCTAssertNil(DNSCapture.parseIPUDPHeader(data), "IPv4 MF fragment must be rejected")
        // Reset MF, set fragment offset = 1
        data[data.startIndex + 6] = 0x00
        data[data.startIndex + 7] = 0x01  // fragment offset = 1
        XCTAssertNil(DNSCapture.parseIPUDPHeader(data), "IPv4 non-zero fragment offset must be rejected")
    }

    /// Hostile-input rejection: this parser handles attacker-controlled packets, so every guard must
    /// actually reject. Previously only well-formed headers were tested — a parser that accepted
    /// malformed / non-UDP / truncated / short-payload packets would have passed. Each must return nil.
    func testParseIPUDPHeaderRejectsHostileInput() {
        // Empty and truncated IPv4 (< 20 bytes)
        XCTAssertNil(DNSCapture.parseIPUDPHeader(Data()), "empty data")
        XCTAssertNil(DNSCapture.parseIPUDPHeader(Data([0x45, 0x00, 0x00])), "truncated IPv4")
        // Unknown IP version (5)
        XCTAssertNil(DNSCapture.parseIPUDPHeader(Data([0x50] + [UInt8](repeating: 0, count: 60))), "unknown IP version")
        // C019: IPv4 TCP on non-port-53 must still be rejected
        let tcpNonPort53 = makeIPv4Header(ihlWords: 5, protocolNumber: 6, srcIP: [10, 0, 0, 1], dstIP: [8, 8, 8, 8], optionsBytes: 0)
        // Build a fake TCP header with non-53 ports (20-byte minimum TCP header)
        var tcpHeader = [UInt8](repeating: 0, count: 20)
        tcpHeader[0] = 0xD4; tcpHeader[1] = 0x31 // src port 54321
        tcpHeader[2] = 0x00; tcpHeader[3] = 0x50 // dst port 80
        tcpHeader[12] = 0x50 // data offset = 5 (20 bytes)
        XCTAssertNil(DNSCapture.parseIPUDPHeader(Data(tcpNonPort53 + tcpHeader)), "IPv4 TCP non-port-53")
        // IPv4 UDP but DNS payload < 12 bytes must be rejected
        let ip4 = makeIPv4Header(ihlWords: 5, protocolNumber: 17, srcIP: [10, 0, 0, 1], dstIP: [8, 8, 8, 8], optionsBytes: 0)
        XCTAssertNil(DNSCapture.parseIPUDPHeader(Data(ip4 + makeUDPHeader(srcPort: 1, dstPort: 53, payloadLength: 4) + [UInt8](repeating: 0, count: 4))), "IPv4 DNS payload < 12 bytes")
        // IPv6 but non-UDP/TCP next header (ICMPv6 = 58) must be rejected
        var ip6: [UInt8] = [0x60, 0x00, 0x00, 0x00, 0x00, 0x14, 58, 64] // next header = ICMPv6
        ip6.append(contentsOf: [UInt8](repeating: 0, count: 15) + [1])  // src ::1
        ip6.append(contentsOf: [UInt8](repeating: 0, count: 16))        // dst ::
        XCTAssertNil(DNSCapture.parseIPUDPHeader(Data(ip6 + [UInt8](repeating: 0, count: 20))), "IPv6 non-UDP/TCP next header")
    }

    func testParseDNSPacketQuery() {
        var packet: [UInt8] = [0x12, 0x34] // XID
        packet.append(contentsOf: [0x01, 0x00]) // flags: standard query, RD set, QR=0
        packet.append(contentsOf: [0x00, 0x01]) // QDCOUNT=1
        packet.append(contentsOf: [0x00, 0x00, 0x00, 0x00, 0x00, 0x00]) // AN/NS/AR = 0
        packet.append(contentsOf: encodeDNSName("example.com"))
        packet.append(contentsOf: [0x00, 0x01]) // type A
        packet.append(contentsOf: [0x00, 0x01]) // class IN

        let report = DNSCapture.parseDNSPacket(Data(packet))
        XCTAssertNotNil(report)
        XCTAssertEqual(report?.qr, "Query")
        XCTAssertEqual(report?.questions.first?.questionName, "example.com")
        XCTAssertEqual(report?.questions.first?.questionType, "A")
        XCTAssertEqual(report?.answers.count, 0)
    }

    func testParseDNSPacketResponseWithAnswer() {
        var packet: [UInt8] = [0x12, 0x34] // XID
        packet.append(contentsOf: [0x81, 0x80]) // flags: QR=1, RD, RA, RCODE=0
        packet.append(contentsOf: [0x00, 0x01]) // QDCOUNT=1
        packet.append(contentsOf: [0x00, 0x01]) // ANCOUNT=1
        packet.append(contentsOf: [0x00, 0x00, 0x00, 0x00]) // NS/AR = 0
        packet.append(contentsOf: encodeDNSName("example.com"))
        packet.append(contentsOf: [0x00, 0x01]) // type A
        packet.append(contentsOf: [0x00, 0x01]) // class IN

        // Answer: name via compression pointer back to offset 12, type A, ttl 60, rdata 93.184.216.34
        packet.append(contentsOf: [0xC0, 0x0C])
        packet.append(contentsOf: [0x00, 0x01]) // type A
        packet.append(contentsOf: [0x00, 0x01]) // class IN
        packet.append(contentsOf: [0x00, 0x00, 0x00, 0x3C]) // TTL = 60
        packet.append(contentsOf: [0x00, 0x04]) // RDLENGTH = 4
        packet.append(contentsOf: [93, 184, 216, 34])

        let report = DNSCapture.parseDNSPacket(Data(packet))
        XCTAssertNotNil(report)
        XCTAssertEqual(report?.qr, "Response")
        XCTAssertEqual(report?.answers.count, 1)
        XCTAssertEqual(report?.answers.first?.name, "example.com")
        XCTAssertEqual(report?.answers.first?.type, "A")
        XCTAssertEqual(report?.answers.first?.ttl, 60)
        XCTAssertEqual(report?.answers.first?.rdata, "93.184.216.34")
    }

    func testParseDNSPacketRejectsCompressionLoop() {
        var packet: [UInt8] = [0x12, 0x34]
        packet.append(contentsOf: [0x81, 0x80])
        packet.append(contentsOf: [0x00, 0x01])
        packet.append(contentsOf: [0x00, 0x00, 0x00, 0x00, 0x00, 0x00])
        // A name at offset 12 that is just a self-referential compression pointer to itself.
        packet.append(contentsOf: [0xC0, 0x0C])
        packet.append(contentsOf: [0x00, 0x01])
        packet.append(contentsOf: [0x00, 0x01])

        // Should not hang or crash; the malformed name simply yields no questions.
        let report = DNSCapture.parseDNSPacket(Data(packet))
        XCTAssertNotNil(report)
        XCTAssertEqual(report?.questions.count, 0)
    }

