{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/security/**",
              "ui_kits/nnyx-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|disabled|fullWidth|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, disabled, fullWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|success|danger|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'success' | 'danger' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:glow|tint|padding|radius|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: glow, tint, padding, radius, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='glow'] > Literal[value!=/^(?:blue|success|critical|electric)$/]",
        "message": "<Card> glow must be one of 'blue' | 'success' | 'critical' | 'electric'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tint'] > Literal[value!=/^(?:blue|success|critical|high|warning|info)$/]",
        "message": "<Card> tint must be one of 'blue' | 'success' | 'critical' | 'high' | 'warning' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Detection'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|name|signing|scanner|evidence|key|ref|className|style|children)$/]",
        "message": "<Detection> doesn't accept that prop. Declared props: severity, name, signing, scanner, evidence."
      },
      {
        "selector": "JSXOpeningElement[name.name='Detection'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:critical|high|medium|low|info)$/]",
        "message": "<Detection> severity must be one of 'critical' | 'high' | 'medium' | 'low' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Detection'] > JSXAttribute[name.name='signing'] > Literal[value!=/^(?:apple|appstore|developer|development|unsigned)$/]",
        "message": "<Detection> signing must be one of 'apple' | 'appstore' | 'developer' | 'development' | 'unsigned'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:radius|padding|children|key|ref|className|style|children)$/]",
        "message": "<GlassPanel> doesn't accept that prop. Declared props: radius, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|wordmark|label|sublabel|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: size, wordmark, label, sublabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|size|lineWidth|value|caption|glow|key|ref|className|style|children)$/]",
        "message": "<ProgressRing> doesn't accept that prop. Declared props: progress, size, lineWidth, value, caption, glow."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|key|ref|className|style|children)$/]",
        "message": "<SeverityBadge> doesn't accept that prop. Declared props: severity."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityBadge'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:critical|high|medium|low|info)$/]",
        "message": "<SeverityBadge> severity must be one of 'critical' | 'high' | 'medium' | 'low' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|selected|badge|onClick|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: label, icon, selected, badge, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SigningBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:source|emoji|key|ref|className|style|children)$/]",
        "message": "<SigningBadge> doesn't accept that prop. Declared props: source, emoji."
      },
      {
        "selector": "JSXOpeningElement[name.name='SigningBadge'] > JSXAttribute[name.name='source'] > Literal[value!=/^(?:apple|appstore|developer|development|unsigned)$/]",
        "message": "<SigningBadge> source must be one of 'apple' | 'appstore' | 'developer' | 'development' | 'unsigned'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|color|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:blue|success|critical|high|warning|orange|info)$/]",
        "message": "<StatCard> color must be one of 'blue' | 'success' | 'critical' | 'high' | 'warning' | 'orange' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|color|glow|solid|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: label, color, glow, solid."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:success|critical|warning|blue|high)$/]",
        "message": "<StatusPill> color must be one of 'success' | 'critical' | 'warning' | 'blue' | 'high'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
