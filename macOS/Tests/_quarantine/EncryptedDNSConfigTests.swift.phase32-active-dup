import XCTest
@testable import SyxxKit

/// Encrypt-all-DNS honesty proof. The rule that must never break: the app may say "your DNS is
/// encrypted" ONLY when a save succeeded, the system reports the setting active, AND a real encrypted
/// query completed. A configuration that was merely *installed* must never render as protection —
/// the false-secure this whole product exists to refuse.
final class EncryptedDNSConfigTests: XCTestCase {

    private func classify(save: Bool = true, ent: Bool = false, active: Bool = true, probe: Bool = true) -> EncryptedDNSApplyResult {
        EncryptedDNSConfig.classifyApply(resolverID: "cloudflare", transport: .doh,
                                         saveSucceeded: save, entitlementRejected: ent,
                                         systemReportsActive: active, encryptedProbeCompleted: probe)
    }

    func testAllThreeTrueIsEnabled() {
        XCTAssertTrue(classify().isEnabled, "save + active + verified probe must be the only enabled state")
    }

    // Each missing leg must drop out of "enabled". These are the false-secure guards.
    func testSaveOkButNotActiveIsInconclusiveNotEnabled() {
        let r = classify(active: false)
        XCTAssertFalse(r.isEnabled, "installed-but-not-active must NOT read as encrypted")
        if case .inconclusive = r {} else { XCTFail("expected inconclusive, got \(r)") }
    }

    func testActiveButProbeDidNotCompleteIsInconclusive() {
        let r = classify(probe: false)
        XCTAssertFalse(r.isEnabled, "active-but-unconfirmed must NOT read as encrypted")
        if case .inconclusive = r {} else { XCTFail("expected inconclusive, got \(r)") }
    }

    func testSaveFailedIsFailedNotEnabled() {
        let r = classify(save: false)
        XCTAssertFalse(r.isEnabled)
        if case .failed = r {} else { XCTFail("expected failed, got \(r)") }
    }

    // The entitlement rejection is distinct so the UI can name exactly what is needed.
    func testEntitlementRejectionIsItsOwnState() {
        let r = classify(save: false, ent: true)
        if case .entitlementRequired = r {} else { XCTFail("expected entitlementRequired, got \(r)") }
    }

    func testCatalogIsWellFormedAndDefaultExists() {
        XCTAssertNotNil(EncryptedDNSConfig.resolver(id: EncryptedDNSConfig.defaultResolverID),
                        "the default resolver id must resolve to a catalog entry")
        for r in EncryptedDNSConfig.catalog {
            XCTAssertTrue(r.dohURL?.hasPrefix("https://") == true, "\(r.id) DoH URL must be https")
            XCTAssertFalse(r.dotHost?.isEmpty ?? true, "\(r.id) must have a DoT host")
            XCTAssertFalse(r.addresses.isEmpty, "\(r.id) must have server addresses")
        }
    }
}
