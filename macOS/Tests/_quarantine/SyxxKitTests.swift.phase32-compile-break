    func testFirstLaunchDateIsStableAcrossCalls() async {
        let first = await LicenseManager.getFirstLaunchDate()
        let second = await LicenseManager.getFirstLaunchDate()
        XCTAssertEqual(first, second)
        // Stability alone passes for a constant-returning stub. The first-launch date must also be a
