    /// C7 — integration: the Capture Query Report renders a PER-APP RESOLVER ATTRIBUTION section
    /// that names each process with the resolver it used, keyed on the port-53 side. Uses a real
    /// NDJSON capture with two processes on two different resolvers. Structural assertion (the
    /// off-system FLAG depends on this host's live system resolvers, tested deterministically in
    /// ResolverAttributionTests); this proves the join reaches the rendered report.
    /// Fail state: drop the resolverUsage join → the section shows "None observed" and this REDs.
    func testCaptureReportRendersPerAppResolverAttribution() throws {
        let dir = FileManager.default.temporaryDirectory
            .appendingPathComponent("syxx-c7-\(UUID().uuidString)")
        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
        defer { try? FileManager.default.removeItem(at: dir) }
        let input = dir.appendingPathComponent("cap.jsonl").path
        let report = dir.appendingPathComponent("report.txt").path

        func record(_ proc: String, pid: Int, resolver: String) -> String {
            let q = "\""
            return "{\(q)Process\(q):{\(q)name\(q):\(q)\(proc)\(q),\(q)pid\(q):\(pid),\(q)attributed\(q):true},"
                + "\(q)Timestamp\(q):\(q)2026-07-19 06:00:00.000\(q),"
                + "\(q)Packet\(q):{\(q)Opcode\(q):\(q)Query\(q),\(q)QR\(q):\(q)Query\(q),\(q)Questions\(q):[{\(q)Question Name\(q):\(q)example.com\(q),\(q)Question Class\(q):\(q)IN\(q),\(q)Question Type\(q):\(q)A\(q)}],\(q)Answers\(q):[],\(q)RA\(q):\(q)false\(q),\(q)Rcode\(q):\(q)No error\(q),\(q)RD\(q):\(q)true\(q),\(q)XID\(q):1,\(q)TC\(q):\(q)false\(q),\(q)AA\(q):\(q)false\(q)},"
                + "\(q)Network\(q):{\(q)IP Version\(q):4,\(q)Source IP\(q):\(q)10.0.0.50\(q),\(q)Dest IP\(q):\(q)\(resolver)\(q),\(q)Source Port\(q):54321,\(q)Dest Port\(q):53,\(q)Direction\(q):\(q)Outbound Query\(q)}}"
        }
        let ndjson = [record("Safari", pid: 200, resolver: "10.0.0.1"),
                      record("curl", pid: 900, resolver: "8.8.8.8")].joined(separator: "\n")
        try ndjson.write(toFile: input, atomically: true, encoding: .utf8)

        let output = DNSCaptureReportGenerator.generateReport(
            inputFile: input, outputFile: input, reportFile: report,
            startTime: Date(), durationSeconds: 1)
        let text = output.report

        XCTAssertTrue(text.contains("PER-APP RESOLVER ATTRIBUTION"), "the C7 section must be present")
        XCTAssertTrue(text.contains("Safari: 10.0.0.1"), "Safari's resolver must be attributed")
        XCTAssertTrue(text.contains("curl: 8.8.8.8"), "curl's resolver must be attributed")
        // The D063 coverage caveat must always be stated, never implied away.
        XCTAssertTrue(text.contains("cleartext UDP:53 only"),
                      "the UDP-only coverage limit must be disclosed in the report")
    }

