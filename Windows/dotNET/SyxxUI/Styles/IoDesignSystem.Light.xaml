<!-- Syxx Dimensions light-theme overrides.
     This dictionary is swapped in at runtime by ThemeManager.ApplyTheme("light").
     It redefines the semantic color tokens that change between dark and light modes.
     All other tokens (typography, spacing, non-theme brushes) remain in IoDesignSystem.xaml. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Light background / surface palette ═══ -->
    <Color x:Key="IoBackgroundDarkColor">#FFE6DDF7</Color>
    <Color x:Key="IoSurfaceDarkColor">#FFEEE7FB</Color>
    <Color x:Key="IoSurfaceElevatedColor">#FFDCD0F5</Color>
    <Color x:Key="IoBorderSubtleColor">#FFC8B9EE</Color>
    <Color x:Key="IoBgColor">#FFE6DDF7</Color>
    <Color x:Key="IoCanvasColor">#FFE6DDF7</Color>
    <Color x:Key="IoWindowTopColor">#FFEEE7FB</Color>
    <Color x:Key="IoWindowBottomColor">#FFE6DDF7</Color>
    <Color x:Key="IoSidebarTopColor">#FFDCD0F5</Color>
    <Color x:Key="IoSidebarBottomColor">#FFD4C6F0</Color>
    <Color x:Key="IoNeutralSurface">#FFEEE7FB</Color>
    <Color x:Key="IoNeutralBorder">#FFC8B9EE</Color>

    <!-- ═══ Light text ═══ -->
    <Color x:Key="IoTextColor">#FF2A134D</Color>
    <Color x:Key="IoTextSecondaryColor">#FF6A4FA0</Color>
    <Color x:Key="IoTextMutedColor">#FF9A8FC0</Color>
    <Color x:Key="IoTextFaintColor">#FF7D7399</Color>

    <!-- ═══ Light semantic / module accent colors ═══ -->
    <Color x:Key="IoMirrorYellowColor">#FF8A6A00</Color>
    <Color x:Key="IoGluttonPinkColor">#FFB0286E</Color>
    <Color x:Key="IoCageCyanColor">#FF0A8A8A</Color>
    <Color x:Key="IoWitnessRedColor">#FFB01E38</Color>

    <!-- D306/D309: light-mode teal button text (slightly lighter for pastel surfaces) -->
    <Color x:Key="IoTealButtonTextColor">#FF0E3D37</Color>
    <!-- D310: light-mode nav runes (deeper lavender for contrast on light surfaces) -->
    <Color x:Key="IoRuneMutedColor">#FF6A4FA0</Color>
    <!-- D310: light-mode sidebar subtitle -->
    <Color x:Key="IoSidebarSubtitleColor">#FF6A4FA0</Color>
    <!-- D310: light-mode terminal prompt (warmer, darker gold for readability) -->
    <Color x:Key="IoTerminalPromptColor">#FF9A7A20</Color>

    <!-- ═══ Light severity colors ═══ -->
    <Color x:Key="IoSuccessGreenColor">#FF1E9E8F</Color>
    <Color x:Key="IoCriticalRedColor">#FFC41E3A</Color>
    <Color x:Key="IoWarningAmberColor">#FFC87A10</Color>

    <!-- ═══ Semantic brushes (redefined with light colors) ═══ -->
    <SolidColorBrush x:Key="IoCanvasBrush" Color="{StaticResource IoCanvasColor}" />
    <SolidColorBrush x:Key="IoBgBrush" Color="{StaticResource IoBgColor}" />
    <SolidColorBrush x:Key="IoSurfaceDarkBrush" Color="{StaticResource IoSurfaceDarkColor}" />
    <SolidColorBrush x:Key="IoBackgroundDarkBrush" Color="{StaticResource IoBackgroundDarkColor}" />
    <SolidColorBrush x:Key="IoSurfaceElevatedBrush" Color="{StaticResource IoSurfaceElevatedColor}" />
    <SolidColorBrush x:Key="IoBorderSubtleBrush" Color="{StaticResource IoBorderSubtleColor}" />
    <SolidColorBrush x:Key="IoNeutralSurfaceBrush" Color="{StaticResource IoNeutralSurface}" />
    <SolidColorBrush x:Key="IoNeutralBorderBrush" Color="{StaticResource IoNeutralBorder}" />
    <SolidColorBrush x:Key="IoSidebarBrush" Color="{StaticResource IoSidebarTopColor}" />

    <!-- Text brushes -->
    <SolidColorBrush x:Key="IoTextBrush" Color="{StaticResource IoTextColor}" />
    <SolidColorBrush x:Key="IoTextSecondaryBrush" Color="{StaticResource IoTextSecondaryColor}" />
    <SolidColorBrush x:Key="IoTextMutedBrush" Color="{StaticResource IoTextMutedColor}" />
    <SolidColorBrush x:Key="IoTextFaintBrush" Color="{StaticResource IoTextFaintColor}" />

    <!-- Module accent brushes -->
    <SolidColorBrush x:Key="IoMirrorYellowBrush" Color="{StaticResource IoMirrorYellowColor}" />
    <SolidColorBrush x:Key="IoGluttonPinkBrush" Color="{StaticResource IoGluttonPinkColor}" />
    <SolidColorBrush x:Key="IoCageCyanBrush" Color="{StaticResource IoCageCyanColor}" />
    <SolidColorBrush x:Key="IoWitnessRedBrush" Color="{StaticResource IoWitnessRedColor}" />

    <!-- Severity brushes -->
    <SolidColorBrush x:Key="IoSuccessGreenBrush" Color="{StaticResource IoSuccessGreenColor}" />
    <SolidColorBrush x:Key="IoCriticalRedBrush" Color="{StaticResource IoCriticalRedColor}" />
    <SolidColorBrush x:Key="IoWarningAmberBrush" Color="{StaticResource IoWarningAmberColor}" />

    <!-- D306/D309 + D310: light-mode brush overrides for new design-system tokens -->
    <SolidColorBrush x:Key="IoTealButtonTextBrush" Color="{StaticResource IoTealButtonTextColor}" />
    <SolidColorBrush x:Key="IoRuneMutedBrush" Color="{StaticResource IoRuneMutedColor}" />
    <SolidColorBrush x:Key="IoSidebarSubtitleBrush" Color="{StaticResource IoSidebarSubtitleColor}" />
    <SolidColorBrush x:Key="IoTerminalPromptBrush" Color="{StaticResource IoTerminalPromptColor}" />

    <!-- ═══ Light gradient overrides ═══ -->
    <LinearGradientBrush x:Key="IoSidebarFillBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFDCD0F5" Offset="0" />
        <GradientStop Color="#FFD4C6F0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="IoWindowFillBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFEEE7FB" Offset="0" />
        <GradientStop Color="#FFE6DDF7" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="IoCanvasGlowBrush"
                         Center="0.15,0" GradientOrigin="0.15,0"
                         RadiusX="1.2" RadiusY="1.25"
                         MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#FFE8E0F8" Offset="0.0" />
        <GradientStop Color="#FFE6DDF7" Offset="1.0" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="IoContentGlowBrush"
                         Center="0.7,-0.1" GradientOrigin="0.7,-0.1"
                         RadiusX="1.2" RadiusY="0.7"
                         MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#1A7C5CFF" Offset="0.0" />
        <GradientStop Color="#00000000" Offset="0.55" />
    </RadialGradientBrush>

</ResourceDictionary>
