<Page
    x:Class="SyxxUI.Views.UpdatePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="{StaticResource IoBgBrush}">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo + app name row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="0,0,0,20">
            <Border Width="48" Height="48" CornerRadius="10"
                    Background="{StaticResource IoBlueBrush}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Syxx"
                           FontFamily="{StaticResource IoFontGrotesk}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource IoTextBrush}" />
                <TextBlock Text="DNS Investigator"
                           FontFamily="{StaticResource IoFontGrotesk}"
                           FontSize="12"
                           Foreground="{StaticResource IoTextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Version info -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Current version"
                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                       Foreground="{StaticResource IoTextSecondaryBrush}" />
            <TextBlock Grid.Column="1" x:Name="VersionText"
                       FontFamily="{StaticResource IoFontMonoBold}" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource IoTextBrush}"
                       HorizontalAlignment="Right" />
        </Grid>

        <!-- Last checked -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Last checked"
                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                       Foreground="{StaticResource IoTextSecondaryBrush}" />
            <TextBlock Grid.Column="1" x:Name="LastCheckedText"
                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource IoTextBrush}"
                       HorizontalAlignment="Right" />
        </Grid>

        <!-- Status banner -->
        <Border Grid.Row="3" x:Name="StatusBanner"
                Padding="14,10" CornerRadius="8"
                BorderThickness="1"
                Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse x:Name="StatusDot" Width="8" Height="8"
                         Fill="{StaticResource IoTextSecondaryBrush}"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           FontFamily="{StaticResource IoFontGrotesk}"
                           FontSize="14" FontWeight="Medium"
                           Foreground="{StaticResource IoTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Spacer -->
        <Grid Grid.Row="4" />

        <!-- Button bar -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="12">
            <Button x:Name="DownloadBtn"
                    Click="OnDownloadClick"
                    Visibility="Collapsed"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Download" />
                    <TextBlock Text="Download Update"
                               FontFamily="{StaticResource IoFontGrotesk}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button x:Name="CheckBtn"
                    Click="OnCheckClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock x:Name="CheckBtnText" Text="Check for Updates"
                               FontFamily="{StaticResource IoFontGrotesk}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button x:Name="CloseBtn"
                    Click="OnCloseClick">
                <TextBlock Text="Close"
                           FontFamily="{StaticResource IoFontGrotesk}"
                           FontWeight="SemiBold" />
            </Button>
        </StackPanel>
    </Grid>
</Page>
