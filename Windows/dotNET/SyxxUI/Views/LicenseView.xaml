<Page
    x:Class="SyxxUI.Views.LicenseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource IoBgBrush}">

    <Grid Padding="{StaticResource IoPaddingView}">
        <ScrollViewer>
            <StackPanel Spacing="20">

                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="ACCOUNT • LICENSING"
                               FontFamily="{StaticResource IoFontMono}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource IoBlueBrush}" CharacterSpacing="120" />
                    <TextBlock Text="License and Registration"
                               FontFamily="{StaticResource IoFontDisplay}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource IoTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="All local diagnostics are free forever. Pro unlocks the server-backed checks."
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                               Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Current status (real, from LicenseManager) -->
                <Border Background="{DynamicResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CURRENT STATUS" FontFamily="{StaticResource IoFontMono}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource IoTextSecondaryBrush}" CharacterSpacing="100" />
                        <!-- Live region: entitlement state is resolved asynchronously, so Narrator is
                             told when the real answer replaces the "Checking…" placeholder. -->
                        <TextBlock x:Name="StatusText" Text="Checking your license status…"
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap"
                                   AutomationProperties.Name="Current license status"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <!-- Tier cards -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource IoSurfaceDarkBrush}"
                            CornerRadius="12" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Lite" FontFamily="{StaticResource IoFontGrotesk}"
                                       FontSize="18" FontWeight="Bold" Foreground="{DynamicResource IoTextBrush}" />
                            <TextBlock Text="Free" FontFamily="{StaticResource IoFontGrotesk}"
                                       FontSize="24" FontWeight="Bold" Foreground="{DynamicResource IoTextBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Prophet • resolver accuracy"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                                           Foreground="{DynamicResource IoTextBrush}" />
                                <TextBlock Text="Portal • local network and route trace"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                                           Foreground="{DynamicResource IoTextBrush}" />
                                <TextBlock Text="Glutton • DNS leak test"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                                           Foreground="{DynamicResource IoTextBrush}" />
                                <TextBlock Text="Cage • live query capture"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                                           Foreground="{DynamicResource IoTextBrush}" />
                                <TextBlock Text="Witness • environment trust"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                                           Foreground="{DynamicResource IoTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource IoSurfaceDarkBrush}"
                            CornerRadius="12" Padding="18"
                            BorderBrush="{StaticResource IoBlueBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Pro" FontFamily="{StaticResource IoFontGrotesk}"
                                       FontSize="18" FontWeight="Bold" Foreground="{DynamicResource IoTextBrush}" />
                            <TextBlock x:Name="PriceText" Text="$3.95 / month"
                                       FontFamily="{StaticResource IoFontGrotesk}"
                                       FontSize="24" FontWeight="Bold" Foreground="{DynamicResource IoTextBrush}" />
                            <ComboBox x:Name="PeriodCombo" SelectedIndex="0"
                                      HorizontalAlignment="Center" MinWidth="140"
                                      AutomationProperties.Name="Billing period">
                                <ComboBoxItem Content="Monthly ($3.95/mo)" AutomationProperties.Name="Monthly billing at 3 dollars 95 cents per month" />
                                <ComboBoxItem Content="Yearly ($19.95/yr)" AutomationProperties.Name="Yearly billing at 19 dollars 95 cents per year" />
                            </ComboBox>
                            <TextBlock x:Name="SaveText" Text="Save 58% with yearly"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                       Foreground="{DynamicResource IoSuccessGreenBrush}"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Everything in Lite, plus:"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                                           Foreground="{StaticResource IoBlueBrush}" />
                                <TextBlock Text="Mirror • remote vs local asset comparison"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                                           Foreground="{DynamicResource IoTextBrush}" />
                                <TextBlock Text="Remote static file hash verification"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                                           Foreground="{DynamicResource IoTextBrush}" />
                                <TextBlock Text="Syxx Warp • web structure matching"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                                           Foreground="{DynamicResource IoTextBrush}" />
                                <TextBlock Text="Syxx Leak • DNS privacy logging"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                                           Foreground="{DynamicResource IoTextBrush}" />
                            </StackPanel>
                            <Button x:Name="TrialBtn" Content="Start Pro Trial"
                                    Click="TrialBtn_Click" HorizontalAlignment="Stretch"
                                    Background="{StaticResource IoBlueBrush}"
                                    Foreground="{DynamicResource IoTextBrush}"
                                    AutomationProperties.Name="Start Pro trial"
                                    AutomationProperties.HelpText="Opens the checkout page to begin a three-day free trial of Pro features" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Activate a license key -->
                <Border Background="{DynamicResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Activate a License Key"
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource IoTextBrush}" />
                        <TextBlock Text="Your license key unlocks the Pro checks. It is validated with the licensing service, then kept on this machine. It never travels alongside your DNS data, so your network findings stay unbound from your identity."
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                   Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBox x:Name="KeyBox" PlaceholderText="SYXX-XXXX-XXXX-XXXX-XXXX"
                                     Width="320" FontFamily="{StaticResource IoFontMono}"
                                     AutomationProperties.Name="License key"
                                     AutomationProperties.HelpText="Enter your Syxx license key in the format SYXX-XXXX-XXXX-XXXX-XXXX to activate Pro features" />
                            <Button x:Name="ActivateBtn" Content="Activate"
                                    Click="ActivateBtn_Click"
                                    Background="{StaticResource IoBlueBrush}"
                                    Foreground="{DynamicResource IoTextBrush}"
                                    AutomationProperties.Name="Activate license key"
                                    AutomationProperties.HelpText="Validates your license key with the Syxx licensing service and unlocks Pro features" />
                            <!-- Phase 9.5: the licensing round trip is a network call. macOS shows a
                                 ProgressView here (macOS/Sources/SyxxApp/LicenseView.swift:188); the
                                 Windows twin previously only greyed the button out. Driven from
                                 LicenseView.xaml.cs ActivateBtn_Click, never left spinning on its own. -->
                            <ProgressRing x:Name="ActivateProgress" IsActive="False" Visibility="Collapsed"
                                          Width="18" Height="18" VerticalAlignment="Center"
                                          AutomationProperties.Name="Verifying license key" />
                        </StackPanel>
                        <!-- Real activation outcome — set only from LicenseManager results, never a
                             hardcoded success. Distinguishes invalid key from network failure (D043)
                             and a verified-but-unsaved key (D042). Live region so Narrator hears the
                             outcome without having to hunt for this line. -->
                        <TextBlock x:Name="ActivateStatusText" Text=""
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                   Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap"
                                   AutomationProperties.Name="Activation result"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Text="Need a key? Purchasing is completed on syxx.app; activation happens right here."
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                   Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Privacy note -->
                <Border Background="{DynamicResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Privacy and Network Checks"
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource IoTextBrush}" />
                        <TextBlock Text="Syxx checks for software updates and critical security broadcasts once per launch, in a single request to syxx.app. No tracking parameters are sent."
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                   Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- About / EULA (System Panels parity) -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="AboutBtn" Content="About Syxx" Click="AboutBtn_Click"
                            AutomationProperties.Name="About Syxx"
                            AutomationProperties.HelpText="View version and build information about Syxx" />
                    <Button x:Name="EulaBtn" Content="License Agreement" Click="EulaBtn_Click"
                            AutomationProperties.Name="License agreement"
                            AutomationProperties.HelpText="View the Syxx end-user license agreement" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
