                             {
                                 var cached = LoadCachedResponse();
                                 if (cached is not null && !IsCacheStale())
                                     return cached;
                             }
                             // ^^^ fetches unconditionally; macOS checks dimension_opt_out here
                             try { ... }
                         }

                         ]
