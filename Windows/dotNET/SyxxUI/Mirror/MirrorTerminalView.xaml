<UserControl
    x:Class="SyxxUI.Mirror.MirrorTerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="8" BorderBrush="{DynamicResource IoBorderSubtleBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: Windows Terminal-style tab with close button -->
            <Border Grid.Row="0" Background="#FF1E1E2E" Padding="12,6,8,6"
                    BorderBrush="{DynamicResource IoBorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText" Grid.Column="0"
                               FontFamily="{StaticResource IoFontMonoBold}" FontSize="11"
                               Foreground="{DynamicResource IoTextMutedBrush}"
                               VerticalAlignment="Center" />

                    <!-- Close tab button (Windows Terminal style: small X) -->
                    <Button x:Name="CloseBtn" Grid.Column="1"
                            Content="✕" FontSize="10" Padding="4,2,4,2"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource IoTextFaintBrush}"
                            Visibility="Collapsed"
                            Click="CloseBtn_Click" />
                </Grid>
            </Border>

            <!-- Content area: dark background like Windows Terminal (#0c0c0c) -->
            <ScrollViewer Grid.Row="1" Background="#FF0C0C0C"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="14,10,14,10">
                <StackPanel x:Name="ContentPanel" Spacing="0">

                    <!-- Warning banner (G-02 fallback) -->
                    <Border x:Name="WarningBanner" Visibility="Collapsed"
                            Background="#1AF7931E" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⚠" FontSize="12" Foreground="{DynamicResource IoWarningAmberBrush}" />
                            <TextBlock x:Name="WarningText"
                                       FontFamily="{StaticResource IoFontMono}" FontSize="11"
                                       Foreground="{DynamicResource IoWarningAmberBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Prompt line: PS C:\Users\user> in warm gold (D310: design-system token) -->
                    <StackPanel x:Name="PromptPanel" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                        <TextBlock Text="PS C:\Users\user>"
                                   FontFamily="{StaticResource IoFontMono}" FontSize="12"
                                   Foreground="{StaticResource IoTerminalPromptBrush}" />
                        <TextBlock x:Name="PromptCommandText"
                                   FontFamily="{StaticResource IoFontMono}" FontSize="12"
                                   Foreground="{StaticResource IoTerminalPromptBrush}" />
                    </StackPanel>

                    <!-- Summary line -->
                    <TextBlock x:Name="SummaryText" Visibility="Collapsed"
                               FontFamily="{StaticResource IoFontMono}" FontSize="10"
                               Foreground="{DynamicResource IoTextFaintBrush}"
                               Margin="0,0,0,6" />

                    <!-- Content sections -->
                    <StackPanel x:Name="SectionsPanel" Spacing="0" />

                    <!-- Placeholder for empty state -->
                    <TextBlock x:Name="PlaceholderText" Visibility="Collapsed"
                               Text="No content captured yet.&#x0a;Run a Mirror check to populate this pane."
                               FontFamily="{StaticResource IoFontMono}" FontSize="12"
                               Foreground="{DynamicResource IoTextFaintBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
