        XCTAssertEqual(DNSSECVerifier.classify(records: records, now: Date(timeIntervalSince1970: 1_500_000)), .inconclusive)
    }

    func testClassifyDNSKEYWithValidRRSIGIsRecordsPresent() {
        let records = [dnskeyRecord(), rrsigDnskeyRecord(inception: 1_000_000, expiration: 2_000_000)]
        XCTAssertEqual(DNSSECVerifier.classify(records: records, now: Date(timeIntervalSince1970: 1_500_000)), .recordsPresentUnverified)
    }

    func testClassifyDNSKEYWithExpiredRRSIGIsExpired() {
        let records = [dnskeyRecord(), rrsigDnskeyRecord(inception: 1_000_000, expiration: 2_000_000)]
        XCTAssertEqual(DNSSECVerifier.classify(records: records, now: Date(timeIntervalSince1970: 3_000_000)), .signatureExpiredOrNotYetValid)
    }

    func testDNSSECStatusDescriptionsNeverClaimValidated() {
        // The honest-status invariant: no state's description says "validated" or "protected".
        for status in [DNSSECStatus.unsigned, .recordsPresentUnverified, .signatureExpiredOrNotYetValid, .inconclusive] {
            let text = status.description.lowercased()
            XCTAssertFalse(text.contains("validated"))
            XCTAssertFalse(text.contains("protected"))
        }
    }

