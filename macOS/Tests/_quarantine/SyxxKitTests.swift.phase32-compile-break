        XCTAssertLessThanOrEqual(first, Date(), "first-launch date must not be in the future")
    }

    // MARK: - E-7 offline grace predicate (LicenseManager)

    /// Grace applies when nowMs is within the 30-day window.
    ///
    /// Mutation: remove the `<= graceWindowMs` guard in `offlineGraceApplies` → this test REDs
    /// because a 0-ms delta (lastValidMs == nowMs) would still return false.
    func testOfflineGrace_WithinWindow_ReturnsTrue() {
        let now: Int64 = 1_000_000_000_000
        let last: Int64 = now - (5 * 24 * 60 * 60 * 1000) // 5 days ago — well within 30
        XCTAssertTrue(
            LicenseManager.offlineGraceApplies(nowMs: now, lastValidMs: last),
            "grace must apply when last validation is 5 days ago (within 30-day window)")
    }

    /// Grace must NOT apply when the last validation is outside the window.
    ///
    /// Mutation: replace `<= graceWindowMs` with `< graceWindowMs` in the predicate → still passes
    /// for all values except the exact boundary, so mutation uses a value clearly outside.
    func testOfflineGrace_OutsideWindow_ReturnsFalse() {
        let now: Int64 = 1_000_000_000_000
        let last: Int64 = now - (31 * 24 * 60 * 60 * 1000) // 31 days ago — outside 30-day window
        XCTAssertFalse(
            LicenseManager.offlineGraceApplies(nowMs: now, lastValidMs: last),
            "grace must NOT apply when last validation is 31 days ago")
    }

    /// No recorded validation — grace must never apply.
    ///
    /// Mutation: remove the `guard let last = lastValidMs else { return false }` guard →
    /// this test REDs because nil would be treated as 0 (distantPast) and could pass the window check.
    func testOfflineGrace_NilLastValid_ReturnsFalse() {
        let now: Int64 = 1_000_000_000_000
        XCTAssertFalse(
            LicenseManager.offlineGraceApplies(nowMs: now, lastValidMs: nil),
            "grace must NOT apply when no prior validation has been recorded")
    }

    /// Boundary: grace applies exactly at the edge of the 30-day window.
    func testOfflineGrace_ExactlyAtBoundary_ReturnsTrue() {
        let now: Int64 = 1_000_000_000_000
        let graceMs: Int64 = 30 * 24 * 60 * 60 * 1000
        let last = now - graceMs // exactly 30 days ago
        XCTAssertTrue(
            LicenseManager.offlineGraceApplies(nowMs: now, lastValidMs: last),
            "grace must apply at exactly the 30-day boundary (inclusive)")
    }

