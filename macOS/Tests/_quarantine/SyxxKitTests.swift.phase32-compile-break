    // MARK: - Trust: passive-DNS ledger + Sentinel (Batch 6)

    func testAnswerLedgerFlagsDriftOnChangedAnswer() {
        let ledger = AnswerLedger()
        // C103: first-seen is .firstSeen, not nil.
        if case .firstSeen = ledger.record(domain: "bank.example", queryType: "A", answer: "203.0.113.10", resolver: "1.1.1.1", ttl: 300) {} else {
            XCTFail("First observation should be .firstSeen")
        }
        // Same answer again -> .consistent, not nil.
        if case .consistent = ledger.record(domain: "bank.example", queryType: "A", answer: "203.0.113.10", resolver: "1.1.1.1", ttl: 300) {} else {
            XCTFail("Matching answer should be .consistent")
        }
        // Different answer -> .drifted.
        if case .drifted(let drift, let isDisjoint) = ledger.record(domain: "bank.example", queryType: "A", answer: "45.9.9.9", resolver: "1.1.1.1", ttl: 60) {
            XCTAssertEqual(drift.previousAnswer, "203.0.113.10")
            XCTAssertEqual(drift.newAnswer, "45.9.9.9")
            XCTAssertTrue(isDisjoint, "Single-answer sets with different values are disjoint")
        } else {
            XCTFail("Changed answer should be .drifted")
        }
        XCTAssertEqual(ledger.history(for: "bank.example").count, 3)
    }

