<Page
    x:Class="SyxxUI.Views.MirrorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SyxxUI.Views"
    xmlns:pres="using:SyxxUI.Presentation"
    xmlns:mirror="using:SyxxUI.Mirror"
    Background="Transparent">

    <ScrollViewer>
    <Grid Padding="32,18,32,32">
        <StackPanel Spacing="20">

            <!-- Header: module header + PRO pill (parity with macOS MirrorView). -->
            <pres:ModuleHeader x:Name="Header" Rune="&#x16DE;" Eyebrow="THE REFLECTION &#xB7; REMOTE VS LOCAL" Name="Mirror"
                               AccentBrush="{StaticResource IoElectricBrush}" />

            <!-- Form input, with the ornate helper paragraph above the row. -->
            <Border Background="{DynamicResource IoSurfaceDarkBrush}" CornerRadius="10" Padding="14"
                    BorderBrush="{DynamicResource IoBorderSubtleBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="In the mirror you shall see the domain or site of web for which you are endeared: The light of the mirror breaks the bonds of deception, revealing whether the site you receive is the same one shown to all. (The Mirror compares cryptographic hashes of the page as your network delivers it against a copy fetched through a clean, independent path, confirming that what you receive is the content served to everyone else.)"
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                               Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBox x:Name="DomainBox" PlaceholderText="Domain (e.g., github.com)" Width="220" />
                        <Button x:Name="CheckBtn" Content="Check"
                                Click="CheckBtn_Click"
                                Background="{StaticResource IoElectricBrush}"
                                Foreground="{DynamicResource IoTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Plain-language description (macOS places it below the input card). -->
            <TextBlock Text="Mirror tests your DNS resolver for signs of tampering or censorship by resolving a given domain both locally and remotely, comparing the hashes for static web components, e.g., external JavaScript files."
                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                       Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap" />

            <!-- Side-by-side comparison -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- DNS resolver matching -->
                <Border Grid.Column="0" Background="{DynamicResource IoSurfaceDarkBrush}"
                        CornerRadius="12" Padding="16"
                        BorderBrush="{DynamicResource IoBorderSubtleBrush}" BorderThickness="1"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="12">
                        <TextBlock Text="DNS RESOLVER MATCHING:"
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource IoAccentStartBrush}" />
                        <TextBlock x:Name="ComparisonEmptyText"
                                   Text="Run a check to see resolver comparison results."
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                                   Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel x:Name="ComparisonContent" Spacing="10" Visibility="Collapsed">
                            <ItemsControl x:Name="ResolverRowsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="views:ResolverRow">
                                        <Border Background="{DynamicResource IoBackgroundDarkBrush}"
                                                CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                                BorderBrush="{DynamicResource IoBorderSubtleBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                                              Foreground="{StaticResource IoElectricBrush}"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind Name}"
                                                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource IoTextSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Ips}"
                                                           FontFamily="{StaticResource IoFontMonoBold}" FontSize="14"
                                                           Foreground="{DynamicResource IoTextBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind StatusLine}"
                                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                                           Foreground="{x:Bind StatusBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Result box (colour set in code-behind; never green unless resolvers agree) -->
                            <Border x:Name="ComparisonResultBox" CornerRadius="8" Padding="10" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="ComparisonResultLabel"
                                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold" />
                                    <TextBlock x:Name="ComparisonResultDetail"
                                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                               Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Static content integrity -->
                <Border Grid.Column="2" Background="{DynamicResource IoSurfaceDarkBrush}"
                        CornerRadius="12" Padding="16"
                        BorderBrush="{DynamicResource IoBorderSubtleBrush}" BorderThickness="1"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="12">
                        <TextBlock Text="STATIC CONTENT INTEGRITY:"
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource IoAccentStartBrush}" />

                        <!-- Empty / PRO-gate states -->
                        <TextBlock x:Name="WarpEmptyText"
                                   Text="Run a check to see integrity results."
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                                   Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel x:Name="WarpProGate" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="CONTENT WARP REQUIRES PRO"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource IoAccentStartBrush}" />
                            <TextBlock Text="Content Warp requires a Pro license. Upgrade at syxx.app"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                       Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="WarpContent" Spacing="10" Visibility="Collapsed">
                            <Border Background="{DynamicResource IoBackgroundDarkBrush}"
                                    CornerRadius="8" Padding="12"
                                    BorderBrush="{DynamicResource IoBorderSubtleBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE83D;" FontSize="14"
                                                  Foreground="{StaticResource IoElectricBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Remote structure"
                                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource IoTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="RemoteStructureText"
                                               FontFamily="{StaticResource IoFontMono}" FontSize="13"
                                               Foreground="{DynamicResource IoTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="Retrieved via off-network vantage proxy"
                                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                               Foreground="{DynamicResource IoTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource IoBackgroundDarkBrush}"
                                    CornerRadius="8" Padding="12"
                                    BorderBrush="{DynamicResource IoBorderSubtleBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="14"
                                                  Foreground="{StaticResource IoElectricBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Local structure"
                                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource IoTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="LocalStructureText"
                                               FontFamily="{StaticResource IoFontMono}" FontSize="13"
                                               Foreground="{DynamicResource IoTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="Retrieved locally from destination server"
                                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="11"
                                               Foreground="{DynamicResource IoTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="WarpResultBox" CornerRadius="8" Padding="10" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="WarpResultLabel"
                                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold" />
                                    <TextBlock x:Name="WarpResultDetail"
                                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                               Foreground="{DynamicResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- View Details: expandable terminal-style diff section -->
            <Border x:Name="DetailsSection" Background="{DynamicResource IoSurfaceDarkBrush}"
                    CornerRadius="12" Padding="16" Visibility="Collapsed"
                    BorderBrush="{DynamicResource IoBorderSubtleBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="DETAILED COMPARISON"
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource IoAccentStartBrush}" />

                    <!-- Degradation score badge -->
                    <mirror:MirrorDegradationBadge x:Name="DegradationBadge"
                                                   HorizontalAlignment="Left" />

                    <!-- Side-by-side terminal panes -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <mirror:MirrorTerminalView x:Name="RemoteTerminal" Grid.Column="0" />
                        <mirror:MirrorTerminalView x:Name="LocalTerminal" Grid.Column="2" />
                    </Grid>

                    <!-- Unified diff view -->
                    <mirror:MirrorDiffView x:Name="DiffView" />
                </StackPanel>
            </Border>

            <!-- View Details toggle button -->
            <Button x:Name="ToggleDetailsBtn" Content="▼ View Details"
                    Click="ToggleDetails_Click"
                    Background="Transparent"
                    Foreground="{StaticResource IoElectricBrush}"
                    BorderBrush="{DynamicResource IoBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,8,16,8"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" />

        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
