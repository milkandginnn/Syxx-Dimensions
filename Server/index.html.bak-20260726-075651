  <script>
    // ---- Page toggle (home ⇄ beta) ------------------------------------
    function goBeta() {
      document.getElementById('page-home').classList.add('hidden');
      document.getElementById('page-beta').classList.remove('hidden');
      window.scrollTo(0, 0);
    }
    function goHome() {
      document.getElementById('page-beta').classList.add('hidden');
      document.getElementById('page-home').classList.remove('hidden');
      window.scrollTo(0, 0);
    }

    // ---- Content injected from data (keeps markup DRY) ----------------
    const TOOLS = [
      { n: "01", name: "Prophet", desc: "Tests your DNS resolver for accuracy." },
      { n: "02", name: "Mirror",  desc: "Checks downloaded web content against a remote copy." },
      { n: "03", name: "Portal",  desc: "Maps your LAN state and the route to a domain." },
      { n: "04", name: "Glutton", desc: "DNS leak test for vulnerable VPN connections." },
      { n: "05", name: "Cage",    desc: "Captures & evaluates the processes behind queries." },
      { n: "06", name: "Witness", desc: "Trust analysis for your home or office environment." },
    ];
    const NNYX_POINTS = [
      "'Omni-engine' scrapes macOS for signatures, heuristics, and behavioral fingerprints.",
      "AI-driven triage to reduce false positives and negatives.",
      "Privacy and configurability as design cornerstones.",
    ];
    const ZZYN_POINTS = [
      "Process-specific block/allow rules, based on a zero trust philosophy.",
      "Features tiered by user skill level.",
      "AI-driven triage, grounded in machine learning.",
    ];
    const CHECK_SVG = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--io-electric)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

    function el(tag, cls, html) { const e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; }

    document.getElementById('tools-grid').append(...TOOLS.map(t =>
      el('div', 'tool', `<div class="n">${t.n}</div><div><div class="name">${t.name}</div><div class="desc">${t.desc}</div></div>`)));
    for (const [id, pts] of [['nnyx-points', NNYX_POINTS], ['zzyn-points', ZZYN_POINTS]]) {
      document.getElementById(id).append(...pts.map(p => el('div', 'point', `${CHECK_SVG}<span>${p}</span>`)));
    }

    // ---- Console demo -------------------------------------------------
    // A deliberately whimsical, unmistakably-fictional bedtime tale — NOT a
    // capture or diagnostic replay. It shares the terminal with the real,
    // paywalled investigation below, which clears the pane before it writes;
    // the tale detects that takeover (its command line is gone) and stops,
    // so it never interleaves with real output.
    const termBody = document.getElementById('term-body');
    function addTerminalLine(text, className) {
      const line = el('div', className);
      line.textContent = text;
      termBody.appendChild(line);
      termBody.scrollTop = termBody.scrollHeight;
    }

    const TALE_CMD = "you@syxx ~ % story --once-upon-a-resolver";
    const tale = [
      ["t-gold", "✦ ──────────  A Syxx bedtime tale  ────────── ✦"],
      ["t-dim",  ""],
      ["t-gold", "Once upon a resolver, six friends set out to find the Encrypted DNS packets —"],
      ["t-dim",  "said to sleep in a far meadow of the network, where no eavesdropper could hear."],
      ["t-dim",  ""],
      ["t-info", "Prophet walked ahead, listening for the truth inside every answer."],
      ["t-info", "Mirror raised her looking-glass, so no imposter could slip past unseen."],
      ["t-info", "Portal unrolled the winding path and lit each hop with a lantern."],
      ["t-info", "Glutton sniffed the air, famished for any secret that had wandered off its leash."],
      ["t-info", "Cage carried a soft net, to cradle whatever they found without a scratch."],
      ["t-info", "Witness brought wax and seal, to sign the tale so none could rewrite it."],
      ["t-dim",  ""],
      ["t-dim",  "A trickster wore a friend's face; Mirror caught the seam and only smiled."],
      ["t-dim",  "A whisper tried to steal away; Glutton's nose found it, Cage's net held it safe and whole."],
      ["t-dim",  "And there, curled and glowing, slept the Encrypted DNS packets — humming a lullaby no one could read."],
      ["t-dim",  ""],
      ["t-info", "\"They are exactly who they claim to be,\" said Prophet."],
      ["t-gold", "Witness pressed her seal. The six tucked the packets in, and the meadow stayed quiet till morning."],
      ["t-gold", "✦ ────────────  The end  ──────────── ✦"],
    ];

    // True only while the terminal is still showing OUR tale (its first line is
    // the story command). A real investigation replaces the first line, so this
    // turns false and every scheduled step bows out.
    function taleOwnsTerminal() {
      return termBody.firstChild && termBody.firstChild.textContent === TALE_CMD;
    }

    function playTale(fresh) {
      if (fresh) { termBody.innerHTML = ""; addTerminalLine(TALE_CMD, "t-cmd"); }
      let i = 0;
      const step = () => {
        if (!taleOwnsTerminal()) return;              // real investigation took over
        if (i < tale.length) {
          addTerminalLine(tale[i][1], tale[i][0]);
          i++;
          setTimeout(step, 850);
        } else {
          addTerminalLine("you@syxx ~ % ", "t-cmd");
          setTimeout(() => { if (taleOwnsTerminal()) playTale(true); }, 6000);
        }
      };
      step();
    }
    setTimeout(() => playTale(false), 1200);

    // ---- Real, paywalled investigation --------------------------------
    // The live query hits /api/investigate, which requires an activated Pro license.
    // Without one the server returns 402 and this page only offers the activation
    // field — it cannot run the paid search for free.
    const SESSION_KEY = "syxx_session";
    function session() { return localStorage.getItem(SESSION_KEY); }

    function showGate(msg) {
      document.getElementById('activation-row').classList.remove('hidden');
      const g = document.getElementById('gate-msg');
      g.classList.remove('hidden');
      g.textContent = msg;
    }

    async function activateLicense() {
      const key = document.getElementById('license-input').value.trim();
      if (!key) return;
      const g = document.getElementById('gate-msg');
      g.classList.remove('hidden');
      g.textContent = "Verifying license…";

      // Separate a genuine failure-to-reach-the-server (fetch throws) from a server that
      // answered and rejected the key — the latter must read as "invalid", not "network error".
      let res;
      try {
        res = await fetch('/api/auth/activate', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key })
        });
      } catch (e) {
        g.textContent = "✗ Couldn't reach the license server — check your connection and try again.";
        return;
      }
      let data = {};
      try { data = await res.json(); } catch (e) { /* non-JSON body; decide on status below */ }

      if (res.ok && data.token) {
        localStorage.setItem(SESSION_KEY, data.token);
        document.getElementById('activation-row').classList.add('hidden');
        g.textContent = "✓ Syxx Pro active — live investigation unlocked.";
        runInvestigation();
        return;
      }
      if ([401, 402, 403, 404].includes(res.status)) {
        g.textContent = "✗ " + (data.error || "That license key is invalid or inactive.");
        return;
      }
      g.textContent = "✗ " + (data.error || ("Activation failed (server returned " + res.status + ")."));
    }

    async function runInvestigation() {
      const val = document.getElementById('domain-input').value.trim();
      if (!val) return;
      if (!session()) {
        showGate("🔒 Live investigation is a Syxx Pro feature. Activate your license to run server-side queries.");
        return;
      }
      document.getElementById('console').scrollIntoView({ behavior: 'smooth' });
      termBody.innerHTML = "";
      addTerminalLine(`you@syxx ~ % syxx ${val}`, "t-cmd");
      addTerminalLine("--------------------------------------------------", "t-dim");
      addTerminalLine(`Investigating domain: ${val}`, "t-info");
      addTerminalLine("· Querying public vantage points…", "t-dim");

      let res;
      try {
        res = await fetch('/api/investigate?domain=' + encodeURIComponent(val), {
          headers: { 'Authorization': 'Bearer ' + session() }
        });
      } catch (e) {
        addTerminalLine("  ✗ Network error reaching the Syxx server.", "t-bad");
        return;
      }
      if (res.status === 402) {
        localStorage.removeItem(SESSION_KEY);
        showGate("🔒 Your session expired. Re-activate your Syxx Pro license.");
        addTerminalLine("  ✗ Payment required — activate a license to continue.", "t-bad");
        return;
      }
      const data = await res.json();
      if (!res.ok) { addTerminalLine("  ✗ " + (data.error || "Query failed"), "t-bad"); return; }

      renderVantage("IPv4 (A)", data.ipv4);
      renderVantage("IPv6 (AAAA)", data.ipv6);

      const verdictClass = data.consensus === "divergent" ? "t-bad"
        : data.consensus.startsWith("consistent") ? "t-ok" : "t-dim";
      addTerminalLine(`Consensus: ${data.consensus.toUpperCase()}`, "t-info");
      addTerminalLine("  " + data.consensusReason, verdictClass);
      const ds = data.dnssec;
      addTerminalLine(`  DNSSEC observed: ${ds.observed ? "yes" : "no"} (AD bit: ${ds.adBit ? "set" : "unset"}) — ${ds.note}`, "t-dim");
      addTerminalLine("you@syxx ~ % ", "t-cmd");
    }

    function renderVantage(label, byResolver) {
      addTerminalLine(`· ${label}:`, "t-dim");
      for (const [server, d] of Object.entries(byResolver || {})) {
        if (d.status === "ok" && d.values.length) {
          addTerminalLine(`  ✓ ${server}: ${d.values.join(", ")}`, "t-ok");
        } else if (d.status === "ok") {
          addTerminalLine(`  · ${server}: no records`, "t-dim");
        } else {
          addTerminalLine(`  ✗ ${server}: ${d.error}`, "t-bad");
        }
      }
    }

    // ---- Beta reservation --------------------------------------------
    async function reserveBeta() {
      const email = document.getElementById('beta-email').value.trim();
      const interests = [];
      if (document.getElementById('beta-nnyx').checked) interests.push('nnyx');
      if (document.getElementById('beta-zzyn').checked) interests.push('zzyn');
      const m = document.getElementById('beta-msg');

      if (!email) { m.style.color = "#f0a04a"; m.textContent = "Enter your email to reserve a seat."; return; }
      if (!interests.length) { m.style.color = "#f0a04a"; m.textContent = "Pick at least one product (Nnyx or Zzyn)."; return; }

      m.style.color = "#efe6ff";
      m.textContent = "Reserving…";
      let res;
      try {
        res = await fetch('/api/beta/reserve', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, interests })
        });
      } catch (e) {
        m.style.color = "#f0a04a";
        m.textContent = "✗ Couldn't reach the server — try again in a moment.";
        return;
      }
      let data = {};
      try { data = await res.json(); } catch (e) {}
      if (res.ok && data.ok) {
        const which = data.interests.map(i => i === 'nnyx' ? 'Nnyx' : 'Zzyn').join(' & ');
        m.style.color = "var(--io-ok)";
        m.textContent = data.confirmation
          ? `✓ You're on the list for ${which} — check your inbox for a confirmation.`
          : `✓ You're on the list for ${which}. We'll email you when the beta opens.`;
        return;
      }
      m.style.color = "#f0a04a";
      m.textContent = "✗ " + (data.error || ("Something went wrong (server returned " + res.status + ")."));
    }

    // ---- Live passive-DNS record count (public marketing stat) --------
    (async function loadStats() {
      try {
        const r = await fetch('/api/stats');
        const d = await r.json();
        document.getElementById('live-status-text').textContent =
          `Passive DNS index live · ${Number(d.passiveRecords).toLocaleString()} records`;
      } catch (e) { /* leave default text */ }
    })();
  </script>
