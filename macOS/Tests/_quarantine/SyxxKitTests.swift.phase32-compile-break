    /// The snapshot test above is vacuous on a build machine with an empty ARP table (the loop body
    /// never runs). This drives the pure parser with a known `arp -a` fixture so field extraction and
    /// malformed-line rejection are actually asserted, not just "did not throw".
    func testARPTableParserExtractsFieldsAndDropsMalformed() {
        let output = """
        ? (192.168.1.1) at aa:bb:cc:dd:ee:ff on en0 ifscope [ethernet]
        router.local (192.168.1.254) at 11:22:33:44:55:66 on en0 ifscope [ethernet]
        this line has no arp structure at all
        """
        let entries = ARPTableParser.parse(output)
        XCTAssertEqual(entries.count, 2, "two well-formed lines parse; the malformed line must be dropped")
        let gw = entries.first { $0.ipAddress == "192.168.1.1" }
        XCTAssertEqual(gw?.macAddress, "aa:bb:cc:dd:ee:ff")
        XCTAssertEqual(gw?.interface, "en0")
        XCTAssertNil(gw?.host, "a '?' host token must map to nil, not the literal '?'")
        let router = entries.first { $0.ipAddress == "192.168.1.254" }
        XCTAssertEqual(router?.host, "router.local")
        XCTAssertEqual(router?.macAddress, "11:22:33:44:55:66")
    }

