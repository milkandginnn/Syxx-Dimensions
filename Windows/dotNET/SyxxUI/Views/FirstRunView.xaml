<UserControl
    x:Class="SyxxUI.Views.FirstRunView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root"
          Background="{StaticResource IoBgBrush}"
          Padding="30">

        <ProgressRing x:Name="LoadingIndicator"
                      Width="46"
                      Height="46"
                      IsActive="True"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Loading setup" />

        <Border x:Name="AgreementPanel"
                Width="600"
                MaxHeight="570"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource IoSurfaceDarkBrush}"
                BorderBrush="{StaticResource IoBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Padding="30,14,30,12"
                            Spacing="5"
                            HorizontalAlignment="Stretch">
                    <TextBlock Text="⚖"
                               FontSize="30"
                               HorizontalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="End-User License Agreement"
                               FontFamily="{StaticResource IoFontDisplay}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource IoTextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Please read these terms before continuing."
                               FontFamily="{StaticResource IoFontLore}"
                               FontSize="14"
                               Foreground="{StaticResource IoTextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              MaxHeight="300"
                              Padding="30,20"
                              BorderBrush="{StaticResource IoBorderSubtleBrush}"
                              BorderThickness="0,1,0,1"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="AgreementText"
                               FontFamily="{StaticResource IoFontUI}"
                               FontSize="14"
                               LineHeight="22"
                               Foreground="{StaticResource IoTextBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>

                <CheckBox x:Name="AcceptanceCheck"
                          Grid.Row="2"
                          Content="I have read and agree to the terms above."
                          FontFamily="{StaticResource IoFontUI}"
                          FontSize="14"
                          Foreground="{StaticResource IoTextBrush}"
                          Margin="30,14,30,12"
                          AutomationProperties.HelpText="Required before Syxx can continue" />

                <Grid Grid.Row="3"
                      Padding="30,14">
                    <Button Content="Decline"
                            Click="DeclineButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource IoTextSecondaryBrush}"
                            FontFamily="{StaticResource IoFontUI}"
                            HorizontalAlignment="Left"
                            AutomationProperties.HelpText="Quits Syxx without saving acceptance" />
                    <Button Content="Agree &amp; Continue →"
                            Click="AcceptButton_Click"
                            Background="{StaticResource IoTealButtonBrush}"
                            Foreground="{StaticResource IoBackgroundDarkBrush}"
                            BorderThickness="0"
                            CornerRadius="11"
                            Padding="20,10"
                            FontFamily="{StaticResource IoFontUI}"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Right"
                            AutomationProperties.HelpText="Saves acceptance and continues to guided setup" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="SetupPanel"
                Width="960"
                MaxHeight="585"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource IoSurfaceDarkBrush}"
                BorderBrush="{StaticResource IoBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Padding="30,13,30,11"
                            Spacing="5"
                            HorizontalAlignment="Stretch">
                    <Image Source="ms-appx:///Assets/syxx-logo.png"
                           Width="42"
                           Height="42"
                           HorizontalAlignment="Center"
                           AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="Welcome to Syxx"
                               FontFamily="{StaticResource IoFontDisplay}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource IoTextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="A first-run setup takes about a minute. You can change anything later."
                               FontFamily="{StaticResource IoFontLore}"
                               FontSize="15"
                               Foreground="{StaticResource IoTextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Padding="30,14"
                              BorderBrush="{StaticResource IoBorderSubtleBrush}"
                              BorderThickness="0,1,0,1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock Text="STEP 1 · CHOOSE YOUR EXPERIENCE"
                                   FontFamily="{StaticResource IoFontUI}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   CharacterSpacing="220"
                                   Foreground="{StaticResource IoBlueBrush}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="StoryModeButton"
                                    Grid.Column="0"
                                    Click="StoryModeButton_Click"
                                    Padding="14"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Background="{StaticResource IoBackgroundDarkBrush}"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Story Mode"
                                               FontFamily="{StaticResource IoFontDisplay}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource IoTextBrush}" />
                                    <FontIcon x:Name="StorySelectedIcon"
                                              Glyph="&#xE73E;"
                                              Grid.Row="0"
                                              HorizontalAlignment="Right"
                                              Foreground="{StaticResource IoBlueBrush}" />
                                    <TextBlock Grid.Row="1"
                                               Margin="0,8,0,0"
                                               Text="Six wardens, lore, and quest framing guide every check."
                                               FontFamily="{StaticResource IoFontUI}"
                                               FontSize="13"
                                               Foreground="{StaticResource IoTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Button>

                            <Button x:Name="GeneralModeButton"
                                    Grid.Column="1"
                                    Click="GeneralModeButton_Click"
                                    Padding="14"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Background="{StaticResource IoBackgroundDarkBrush}"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="General Mode"
                                               FontFamily="{StaticResource IoFontDisplay}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource IoTextBrush}" />
                                    <FontIcon x:Name="GeneralSelectedIcon"
                                              Glyph="&#xE73E;"
                                              Grid.Row="0"
                                              HorizontalAlignment="Right"
                                              Foreground="{StaticResource IoSuccessGreenBrush}"
                                              Visibility="Collapsed" />
                                    <TextBlock Grid.Row="1"
                                               Margin="0,8,0,0"
                                               Text="Standard technical English, with plain labels and no storybook framing."
                                               FontFamily="{StaticResource IoFontUI}"
                                               FontSize="13"
                                               Foreground="{StaticResource IoTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                        </Grid>

                        <TextBlock Text="STEP 2 · CONFIRM YOUR DEFAULTS"
                                   FontFamily="{StaticResource IoFontUI}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   CharacterSpacing="220"
                                   Foreground="{StaticResource IoBlueBrush}" />

                        <Grid ColumnSpacing="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Padding="0,10">
                                    <StackPanel Margin="0,0,225,0">
                                        <TextBlock Text="Resolver"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource IoTextBrush}" />
                                        <TextBlock Text="Where lookups are sent"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource IoTextMutedBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ResolverCombo"
                                              MinWidth="210"
                                              HorizontalAlignment="Right"
                                              DisplayMemberPath="DisplayName"
                                              AutomationProperties.Name="Resolver" />
                                </Grid>

                                <Grid Padding="0,10">
                                    <StackPanel Margin="0,0,165,0">
                                        <TextBlock Text="Encrypted transport"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource IoTextBrush}" />
                                        <TextBlock Text="Protocol used when encryption is enabled"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource IoTextMutedBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="TransportCombo"
                                              MinWidth="150"
                                              HorizontalAlignment="Right"
                                              SelectedIndex="0"
                                              AutomationProperties.Name="Encrypted transport">
                                        <ComboBoxItem Content="DoH (HTTPS)" Tag="doh" />
                                        <ComboBoxItem Content="DoT (TLS)" Tag="dot" />
                                    </ComboBox>
                                </Grid>

                                <Grid Padding="0,10">
                                    <StackPanel Margin="0,0,90,0">
                                        <TextBlock Text="Encrypt all DNS queries"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource IoTextBrush}" />
                                        <TextBlock Text="Recommended when DNS is cleartext"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource IoTextMutedBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="EncryptDnsToggle"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  IsOn="True"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="Encrypt all DNS queries" />
                                </Grid>

                                <Grid Padding="0,10">
                                    <StackPanel Margin="0,0,90,0">
                                        <TextBlock Text="Notify me on trust changes"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource IoTextBrush}" />
                                        <TextBlock Text="Alerts when the network's trust changes"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource IoTextMutedBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="NotificationsToggle"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  IsOn="True"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="Notify me on trust changes" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Grid Padding="0,10">
                                    <StackPanel Margin="0,0,90,0">
                                        <TextBlock Text="Check for updates automatically"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource IoTextBrush}" />
                                        <TextBlock Text="Contacts syxx.app after setup to check for updates and news"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource IoTextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="260" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="UpdateCheckToggle"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="Check for updates automatically" />
                                </Grid>

                                <Grid Padding="0,10">
                                    <StackPanel Margin="0,0,90,0">
                                        <TextBlock Text="Send crash reports"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource IoTextBrush}" />
                                        <TextBlock Text="Shares diagnostics after setup when enabled"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource IoTextMutedBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="CrashReportingToggle"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="Send crash reports" />
                                </Grid>

                                <Grid Padding="0,10">
                                    <StackPanel Margin="0,0,90,0">
                                        <TextBlock Text="Send anonymous usage statistics"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource IoTextBrush}" />
                                        <TextBlock Text="Shares app operation telemetry after setup when enabled"
                                                   FontFamily="{StaticResource IoFontUI}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource IoTextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="260" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="TelemetryToggle"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="Send anonymous usage statistics" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Padding="30,12">
                    <Button Content="Skip: use defaults"
                            Click="SkipButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource IoTextSecondaryBrush}"
                            FontFamily="{StaticResource IoFontUI}"
                            HorizontalAlignment="Left" />
                    <Button Content="Begin →"
                            Click="BeginButton_Click"
                            Background="{StaticResource IoPrimaryButtonBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="11"
                            Padding="22,10"
                            FontFamily="{StaticResource IoFontUI}"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Right"
                            AutomationProperties.HelpText="Saves these choices and opens What's New" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="FailurePanel"
                Width="540"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource IoSurfaceDarkBrush}"
                BorderBrush="{StaticResource IoBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Visibility="Collapsed">
            <StackPanel Spacing="18">
                <FontIcon Glyph="&#xE814;"
                          FontSize="32"
                          Foreground="{StaticResource IoWarningAmberBrush}"
                          HorizontalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="FailureText"
                           FontFamily="{StaticResource IoFontUI}"
                           FontSize="14"
                           Foreground="{StaticResource IoTextBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            HorizontalAlignment="Center">
                    <Button Content="Quit Syxx"
                            Click="QuitButton_Click"
                            Background="Transparent"
                            BorderBrush="{StaticResource IoBorderSubtleBrush}"
                            Foreground="{StaticResource IoTextBrush}"
                            CornerRadius="9"
                            Padding="16,9" />
                    <Button Content="Try Again"
                            Click="RetryButton_Click"
                            Background="{StaticResource IoPrimaryButtonBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="9"
                            Padding="16,9" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
