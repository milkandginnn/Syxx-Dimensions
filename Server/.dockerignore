# ──────────────────────────────────────────────────────────────────────────────
# .dockerignore — keep the build context small and secrets out of the image
# ──────────────────────────────────────────────────────────────────────────────

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/

# Testing and quality
tests/
.coverage
.coverage-honesty.json
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ty_cache/

# Documentation (not served by the HTTP router)
docs/
*.md
!README.md

# Scripts and tooling
scripts/
dev-keys/

# Docker files (avoid recursive context)
Dockerfile
docker-compose.yml
.dockerignore

# OS artifacts
.DS_Store
Thumbs.db

# CI/CD
.github/
.agent-progress/

# Database files (never bake data into the image)
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment and secrets
.env
.env.*
!.env.example
