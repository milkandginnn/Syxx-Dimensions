<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="SyxxUI.Avalonia.App">

  <Application.Styles>
    <sty:FluentAvaloniaTheme PreferSystemTheme="True" />
  </Application.Styles>

  <Application.Resources>
    <!--
         SYXX FANTASY "SECURITY CONSOLE" DESIGN TOKENS  (Ubuntu / Avalonia client)
         Source of truth: "Syxx GUI Mockups/IMPLEMENTATION_GUIDE.md" §1, transcribed 1:1 from the
         warden artboard. This is a THIRD, deliberately distinct token set from the Windows "Io"
         XAML and the macOS Swift tokens (three-way drift is a known, owner-flagged reconciliation).

         Theme-aware: colors are defined per-variant in ThemeDictionaries below; brushes and
         gradients reference them via DynamicResource so they update on live theme switch.
    -->
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- ═══════════  DARK THEME  ═══════════ -->
        <ResourceDictionary x:Key="Dark">
          <!-- 1.1  COLORS -->
          <Color x:Key="SyxCanvasColor">#0b0518</Color>
          <Color x:Key="SyxWindowTopColor">#170c2e</Color>
          <Color x:Key="SyxWindowBottomColor">#0f0720</Color>
          <Color x:Key="SyxSidebarTopColor">#1d1240</Color>
          <Color x:Key="SyxSidebarBottomColor">#160c30</Color>

          <Color x:Key="SyxVioletColor">#7c5cff</Color>
          <Color x:Key="SyxVioletDeepColor">#5b3fd6</Color>
          <Color x:Key="SyxVioletBrightColor">#a78bff</Color>
          <Color x:Key="SyxVioletPaleColor">#c4b3ff</Color>
          <Color x:Key="SyxTealColor">#2dd4bf</Color>
          <Color x:Key="SyxProphetBlueColor">#00b4ff</Color>
          <Color x:Key="SyxTealDeepColor">#14a89a</Color>
          <Color x:Key="SyxGoldColor">#d9a441</Color>
          <Color x:Key="SyxGoldTextColor">#e0b45a</Color>
          <Color x:Key="SyxOrangeColor">#f7931e</Color>
          <Color x:Key="SyxRedColor">#ff4d6d</Color>
          <Color x:Key="SyxRedDeepColor">#d62a4c</Color>

          <Color x:Key="SyxTextColor">#efeafe</Color>
          <Color x:Key="SyxTextSecondaryColor">#c9c1e6</Color>
          <Color x:Key="SyxTextSecondaryBColor">#b3a7d6</Color>
          <Color x:Key="SyxTextMutedColor">#9a8fc0</Color>
          <Color x:Key="SyxTextMutedBColor">#8f83b8</Color>
          <Color x:Key="SyxTextFaintColor">#6f6597</Color>
          <Color x:Key="SyxTextFaintBColor">#7d7399</Color>

          <!-- Semantic tint helpers and neutral surfaces (guide 1.1 "Standard tints"). ARGB hex. -->
          <Color x:Key="SyxSurfaceFillColor">#08FFFFFF</Color>
          <Color x:Key="SyxNeutralBorderColor">#249478F6</Color>
          <Color x:Key="SyxInputFillColor">#990A0614</Color>

          <!-- Semantic aliases for views that reference Io* names. Maps to Warden opaque surfaces. -->
          <Color x:Key="SyxSurfaceDarkColor">#FF170C2E</Color>
          <Color x:Key="SyxBorderSubtleColor">#FF382C66</Color>

          <!-- Sidebar hairline rgba(148,120,246,.16); gold divider #d9a441 at opacity .32 -->
          <Color x:Key="SyxHairlineColor">#289478F6</Color>
          <Color x:Key="SyxGoldDividerColor">#52d9a441</Color>
          <!-- Nav hover wash rgba(124,92,255,.10) -->
          <Color x:Key="SyxNavHoverColor">#1A7c5cff</Color>

          <!-- Semantic module colors (from macOS IoDynamic tokens) -->
          <Color x:Key="SyxMirrorYellowColor">#ffd400</Color>
          <Color x:Key="SyxGluttonPinkColor">#ff6eb4</Color>
          <Color x:Key="SyxCageCyanColor">#00e5ff</Color>
          <Color x:Key="SyxWitnessRedColor">#ff3355</Color>
          <Color x:Key="SyxSuccessGreenColor">#2dd4bf</Color>
          <Color x:Key="SyxCriticalRedColor">#ff4d6d</Color>
          <Color x:Key="SyxWarningAmberColor">#f7931e</Color>
        </ResourceDictionary>

        <!-- ═══════════  LIGHT THEME  ═══════════ -->
        <ResourceDictionary x:Key="Light">
          <!-- 1.1  COLORS -->
          <Color x:Key="SyxCanvasColor">#e6ddf7</Color>
          <Color x:Key="SyxWindowTopColor">#eee7fb</Color>
          <Color x:Key="SyxWindowBottomColor">#e0d6f3</Color>
          <Color x:Key="SyxSidebarTopColor">#dcd0f5</Color>
          <Color x:Key="SyxSidebarBottomColor">#d4c8ee</Color>

          <Color x:Key="SyxVioletColor">#6b4ce6</Color>
          <Color x:Key="SyxVioletDeepColor">#4a2fb8</Color>
          <Color x:Key="SyxVioletBrightColor">#7c5cff</Color>
          <Color x:Key="SyxVioletPaleColor">#5b3fd6</Color>
          <Color x:Key="SyxTealColor">#1e9e8f</Color>
          <Color x:Key="SyxProphetBlueColor">#0070a0</Color>
          <Color x:Key="SyxTealDeepColor">#0f7a6e</Color>
          <Color x:Key="SyxGoldColor">#a07820</Color>
          <Color x:Key="SyxGoldTextColor">#8a6a10</Color>
          <Color x:Key="SyxOrangeColor">#c87a10</Color>
          <Color x:Key="SyxRedColor">#c41e3a</Color>
          <Color x:Key="SyxRedDeepColor">#a01830</Color>

          <Color x:Key="SyxTextColor">#2a134d</Color>
          <Color x:Key="SyxTextSecondaryColor">#6a4fa0</Color>
          <Color x:Key="SyxTextSecondaryBColor">#7a5fb0</Color>
          <Color x:Key="SyxTextMutedColor">#9a8fc0</Color>
          <Color x:Key="SyxTextMutedBColor">#8a7fb0</Color>
          <Color x:Key="SyxTextFaintColor">#7d7399</Color>
          <Color x:Key="SyxTextFaintBColor">#8d8399</Color>

          <!-- Semantic tint helpers and neutral surfaces -->
          <Color x:Key="SyxSurfaceFillColor">#10000000</Color>
          <Color x:Key="SyxNeutralBorderColor">#249478F6</Color>
          <Color x:Key="SyxInputFillColor">#20D4C8EE</Color>

          <!-- Semantic aliases -->
          <Color x:Key="SyxSurfaceDarkColor">#FFeee7fb</Color>
          <Color x:Key="SyxBorderSubtleColor">#FFc8b9ee</Color>

          <!-- Sidebar hairline, gold divider, nav hover -->
          <Color x:Key="SyxHairlineColor">#289478F6</Color>
          <Color x:Key="SyxGoldDividerColor">#52a07820</Color>
          <Color x:Key="SyxNavHoverColor">#1A6b4ce6</Color>

          <!-- Semantic module colors (light variants from macOS IoDynamic light values) -->
          <Color x:Key="SyxMirrorYellowColor">#8a6a00</Color>
          <Color x:Key="SyxGluttonPinkColor">#b0286e</Color>
          <Color x:Key="SyxCageCyanColor">#0a8a8a</Color>
          <Color x:Key="SyxWitnessRedColor">#b01e38</Color>
          <Color x:Key="SyxSuccessGreenColor">#1e9e8f</Color>
          <Color x:Key="SyxCriticalRedColor">#c41e3a</Color>
          <Color x:Key="SyxWarningAmberColor">#c87a10</Color>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>

      <!-- ═══════════  THEME-INVARIANT BRUSHES (DynamicResource picks the active variant)  ═══════════ -->

      <!-- 1.1  SOLID BRUSHES -->
      <SolidColorBrush x:Key="SyxCanvasBrush" Color="{DynamicResource SyxCanvasColor}" />
      <SolidColorBrush x:Key="SyxVioletBrush" Color="{DynamicResource SyxVioletColor}" />
      <SolidColorBrush x:Key="SyxVioletBrightBrush" Color="{DynamicResource SyxVioletBrightColor}" />
      <SolidColorBrush x:Key="SyxVioletPaleBrush" Color="{DynamicResource SyxVioletPaleColor}" />
      <SolidColorBrush x:Key="SyxTealBrush" Color="{DynamicResource SyxTealColor}" />
      <SolidColorBrush x:Key="SyxProphetBlueBrush" Color="{DynamicResource SyxProphetBlueColor}" />
      <SolidColorBrush x:Key="SyxTealDeepBrush" Color="{DynamicResource SyxTealDeepColor}" />
      <SolidColorBrush x:Key="SyxGoldBrush" Color="{DynamicResource SyxGoldColor}" />
      <SolidColorBrush x:Key="SyxGoldTextBrush" Color="{DynamicResource SyxGoldTextColor}" />
      <SolidColorBrush x:Key="SyxOrangeBrush" Color="{DynamicResource SyxOrangeColor}" />
      <SolidColorBrush x:Key="SyxRedBrush" Color="{DynamicResource SyxRedColor}" />

      <SolidColorBrush x:Key="SyxTextBrush" Color="{DynamicResource SyxTextColor}" />
      <SolidColorBrush x:Key="SyxTextSecondaryBrush" Color="{DynamicResource SyxTextSecondaryColor}" />
      <SolidColorBrush x:Key="SyxTextSecondaryBBrush" Color="{DynamicResource SyxTextSecondaryBColor}" />
      <SolidColorBrush x:Key="SyxTextMutedBrush" Color="{DynamicResource SyxTextMutedColor}" />
      <SolidColorBrush x:Key="SyxTextMutedBBrush" Color="{DynamicResource SyxTextMutedBColor}" />
      <SolidColorBrush x:Key="SyxTextFaintBrush" Color="{DynamicResource SyxTextFaintColor}" />
      <SolidColorBrush x:Key="SyxTextFaintBBrush" Color="{DynamicResource SyxTextFaintBColor}" />

      <SolidColorBrush x:Key="SyxSurfaceFillBrush" Color="{DynamicResource SyxSurfaceFillColor}" />
      <SolidColorBrush x:Key="SyxNeutralBorderBrush" Color="{DynamicResource SyxNeutralBorderColor}" />
      <SolidColorBrush x:Key="SyxInputFillBrush" Color="{DynamicResource SyxInputFillColor}" />

      <!-- Semantic aliases for views that reference Io* names. -->
      <SolidColorBrush x:Key="SyxSurfaceDarkBrush" Color="{DynamicResource SyxSurfaceDarkColor}" />
      <SolidColorBrush x:Key="SyxBorderSubtleBrush" Color="{DynamicResource SyxBorderSubtleColor}" />

      <!-- Sidebar hairline, gold divider, nav hover -->
      <SolidColorBrush x:Key="SyxHairlineBrush" Color="{DynamicResource SyxHairlineColor}" />
      <SolidColorBrush x:Key="SyxGoldDividerBrush" Color="{DynamicResource SyxGoldDividerColor}" />
      <SolidColorBrush x:Key="SyxNavHoverBrush" Color="{DynamicResource SyxNavHoverColor}" />

      <!-- Semantic module brushes -->
      <SolidColorBrush x:Key="SyxMirrorYellowBrush" Color="{DynamicResource SyxMirrorYellowColor}" />
      <SolidColorBrush x:Key="SyxGluttonPinkBrush" Color="{DynamicResource SyxGluttonPinkColor}" />
      <SolidColorBrush x:Key="SyxCageCyanBrush" Color="{DynamicResource SyxCageCyanColor}" />
      <SolidColorBrush x:Key="SyxWitnessRedBrush" Color="{DynamicResource SyxWitnessRedColor}" />
      <SolidColorBrush x:Key="SyxSuccessGreenBrush" Color="{DynamicResource SyxSuccessGreenColor}" />
      <SolidColorBrush x:Key="SyxCriticalRedBrush" Color="{DynamicResource SyxCriticalRedColor}" />
      <SolidColorBrush x:Key="SyxWarningAmberBrush" Color="{DynamicResource SyxWarningAmberColor}" />

      <!-- 1.2  GRADIENTS (DynamicResource for gradient stops) -->
      <!-- Window fill -->
      <LinearGradientBrush x:Key="SyxWindowFillBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="{DynamicResource SyxWindowTopColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SyxWindowBottomColor}" Offset="1" />
      </LinearGradientBrush>

      <!-- Sidebar fill -->
      <LinearGradientBrush x:Key="SyxSidebarFillBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="{DynamicResource SyxSidebarTopColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SyxSidebarBottomColor}" Offset="1" />
      </LinearGradientBrush>

      <!-- Primary button -->
      <LinearGradientBrush x:Key="SyxPrimaryButtonBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{DynamicResource SyxVioletColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SyxVioletDeepColor}" Offset="1" />
      </LinearGradientBrush>

      <!-- Teal button -->
      <LinearGradientBrush x:Key="SyxTealButtonBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{DynamicResource SyxTealColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SyxTealDeepColor}" Offset="1" />
      </LinearGradientBrush>

      <!-- Red button -->
      <LinearGradientBrush x:Key="SyxRedButtonBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{DynamicResource SyxRedColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SyxRedDeepColor}" Offset="1" />
      </LinearGradientBrush>

      <!-- Active nav item -->
      <LinearGradientBrush x:Key="SyxActiveNavBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="{DynamicResource SyxVioletColor}" Offset="0" />
        <GradientStop Color="#6a49ef" Offset="1" />
      </LinearGradientBrush>

      <!-- Wordmark (theme-invariant decorative gradient — stays fixed across themes) -->
      <LinearGradientBrush x:Key="SyxWordmarkBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#ff9a3d" Offset="0" />
        <GradientStop Color="#ff2d78" Offset="0.5" />
        <GradientStop Color="#9a5cff" Offset="1" />
      </LinearGradientBrush>

      <!-- Health meter fill -->
      <LinearGradientBrush x:Key="SyxHealthMeterBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="{DynamicResource SyxTealColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SyxVioletColor}" Offset="1" />
      </LinearGradientBrush>

      <!-- Trust ring stroke -->
      <LinearGradientBrush x:Key="SyxTrustRingBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{DynamicResource SyxTealColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SyxVioletColor}" Offset="1" />
      </LinearGradientBrush>

      <!-- Pro Covenant panel -->
      <LinearGradientBrush x:Key="SyxProCovenantBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#297c5cff" Offset="0" />
        <GradientStop Color="#0F2dd4bf" Offset="1" />
      </LinearGradientBrush>

      <!-- 1.4  CORNER RADII -->
      <CornerRadius x:Key="SyxRadiusBadge">5</CornerRadius>
      <CornerRadius x:Key="SyxRadiusChip">7</CornerRadius>
      <CornerRadius x:Key="SyxRadiusButton">10</CornerRadius>
      <CornerRadius x:Key="SyxRadiusNavItem">9</CornerRadius>
      <CornerRadius x:Key="SyxRadiusCard">14</CornerRadius>
      <CornerRadius x:Key="SyxRadiusWindow">16</CornerRadius>
      <CornerRadius x:Key="SyxRadiusPill">999</CornerRadius>

      <!-- 1.5  SHADOWS and GLOW -->
      <BoxShadows x:Key="SyxWindowShadow">0 40 120 0 #8C000000</BoxShadows>
      <BoxShadows x:Key="SyxPrimaryButtonShadow">0 10 26 0 #667c5cff</BoxShadows>
      <BoxShadows x:Key="SyxActionShadow">0 12 30 0 #667c5cff</BoxShadows>
      <BoxShadows x:Key="SyxActiveNavShadow">0 8 20 0 #667c5cff</BoxShadows>

      <!-- 1.3 TYPOGRAPHY -->
      <FontFamily x:Key="SyxTypeDisplay">avares://Syxx/Assets/Fonts/Cinzel-Bold.ttf#Cinzel</FontFamily>
      <FontFamily x:Key="SyxTypeSectionHeading">avares://Syxx/Assets/Fonts/Cinzel-SemiBold.ttf#Cinzel</FontFamily>
      <FontFamily x:Key="SyxDisplayFont">avares://Syxx/Assets/Fonts/Cinzel-SemiBold.ttf#Cinzel</FontFamily>
      <FontFamily x:Key="SyxTypeBodyLight">avares://Syxx/Assets/Fonts/CormorantGaramond-Light.ttf#Cormorant Garamond Light</FontFamily>
      <FontFamily x:Key="SyxTypeBody">avares://Syxx/Assets/Fonts/CormorantGaramond-Regular.ttf#Cormorant Garamond</FontFamily>
      <FontFamily x:Key="SyxTypeNavLabel">avares://Syxx/Assets/Fonts/Spectral-Light.ttf#Spectral Light</FontFamily>
      <FontFamily x:Key="SyxTypeBodyAlternate">avares://Syxx/Assets/Fonts/CormorantSC-Regular.ttf#Cormorant SC</FontFamily>
      <FontFamily x:Key="SyxTypeDeck">avares://Syxx/Assets/Fonts/CormorantSC-SemiBold.ttf#Cormorant SC</FontFamily>
      <FontFamily x:Key="SyxDeckFont">avares://Syxx/Assets/Fonts/CormorantSC-SemiBold.ttf#Cormorant SC</FontFamily>
      <FontFamily x:Key="SyxTypeEmphasis">avares://Syxx/Assets/Fonts/EBGaramond-Italic.ttf#EB Garamond</FontFamily>
      <FontFamily x:Key="SyxLoreFont">avares://Syxx/Assets/Fonts/EBGaramond-Italic.ttf#EB Garamond</FontFamily>
      <FontFamily x:Key="SyxTypeUiLabel">avares://Syxx/Assets/Fonts/Jost-Medium.ttf#Jost Medium</FontFamily>
      <FontFamily x:Key="SyxTypeEyebrow">avares://Syxx/Assets/Fonts/Jost-Medium.ttf#Jost Medium</FontFamily>
      <FontFamily x:Key="SyxTypeTechnical">avares://Syxx/Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
      <FontFamily x:Key="SyxMonoFont">avares://Syxx/Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
      <FontFamily x:Key="SyxUiFont">avares://Syxx/Assets/Fonts/Jost-Regular.ttf#Jost</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
</Application>
