<UserControl
    x:Class="SyxxUI.Mirror.MirrorDiffView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="8" BorderBrush="{DynamicResource IoBorderSubtleBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Section tabs bar -->
            <Border Grid.Row="0" Background="{DynamicResource IoSurfaceDarkBrush}"
                    BorderBrush="{DynamicResource IoBorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- HTML tab -->
                    <Button x:Name="HtmlTabBtn" Grid.Column="0"
                            Click="HtmlTab_Click" Background="Transparent" BorderThickness="0"
                            Padding="14,8,14,8" CornerRadius="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="HtmlChevron" Text="▶" FontSize="9"
                                       Foreground="{DynamicResource IoTextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="HTML" FontFamily="{StaticResource IoFontMonoBold}" FontSize="11"
                                       Foreground="{DynamicResource IoTextMutedBrush}" />
                            <TextBlock x:Name="HtmlCount" FontFamily="{StaticResource IoFontMono}" FontSize="10"
                                       Foreground="{DynamicResource IoTextFaintBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- CSS tab -->
                    <Button x:Name="CssTabBtn" Grid.Column="1"
                            Click="CssTab_Click" Background="Transparent" BorderThickness="0"
                            Padding="14,8,14,8" CornerRadius="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="CssChevron" Text="▶" FontSize="9"
                                       Foreground="{DynamicResource IoTextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="CSS" FontFamily="{StaticResource IoFontMonoBold}" FontSize="11"
                                       Foreground="{DynamicResource IoTextMutedBrush}" />
                            <TextBlock x:Name="CssCount" FontFamily="{StaticResource IoFontMono}" FontSize="10"
                                       Foreground="{DynamicResource IoTextFaintBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- JavaScript tab -->
                    <Button x:Name="JsTabBtn" Grid.Column="2"
                            Click="JsTab_Click" Background="Transparent" BorderThickness="0"
                            Padding="14,8,14,8" CornerRadius="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="JsChevron" Text="▶" FontSize="9"
                                       Foreground="{DynamicResource IoTextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="JavaScript" FontFamily="{StaticResource IoFontMonoBold}" FontSize="11"
                                       Foreground="{DynamicResource IoTextMutedBrush}" />
                            <TextBlock x:Name="JsCount" FontFamily="{StaticResource IoFontMono}" FontSize="10"
                                       Foreground="{DynamicResource IoTextFaintBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Summary: +N / -N -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="+" FontFamily="{StaticResource IoFontMonoBold}" FontSize="11"
                                       Foreground="{DynamicResource IoSuccessGreenBrush}" />
                            <TextBlock x:Name="AdditionsCount" FontFamily="{StaticResource IoFontMono}" FontSize="11"
                                       Foreground="{DynamicResource IoSuccessGreenBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="−" FontFamily="{StaticResource IoFontMonoBold}" FontSize="11"
                                       Foreground="{DynamicResource IoCriticalRedBrush}" />
                            <TextBlock x:Name="RemovalsCount" FontFamily="{StaticResource IoFontMono}" FontSize="11"
                                       Foreground="{DynamicResource IoCriticalRedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Diff content area -->
            <ScrollViewer Grid.Row="1" Background="#FF0C0C0C"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="12,8,12,8">
                <StackPanel x:Name="DiffContentPanel" Spacing="0" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
