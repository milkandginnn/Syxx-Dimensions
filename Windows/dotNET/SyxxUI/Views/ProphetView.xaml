<Page
    x:Class="SyxxUI.Views.ProphetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- Parity twin of macOS ProphetView.swift (gold standard). Structure top-to-bottom:
         1. Rune header (54x54 teal tile + eyebrow + title + lore subcaption + body paragraph)
         2. Domain selection card (lore + body + domain TextBox + "Divine the Domain" button)
         3. Resolver consensus result card (only when ProphetConsensusResult != null)
         4. DNSSEC result card (only when DnssecStatus != null, BELOW resolver card, not side-by-side)
         5. Empty state (when ProphetConsensusResult == null)
         Removed per parity: top-right Resolver line, DNSSEC-scope warning banner, LOCAL DNS
         ENCRYPTION card, side-by-side records+DNSSEC grid. Kept: Resolver IP (optional) TextBox,
         E146 record-type-picker note, ProgressRing (inert until .cs wires it). -->
    <ScrollViewer>
        <StackPanel Spacing="22" Padding="32">

            <!-- 1. Rune header: 54x54 teal rune tile + eyebrow + title + lore + body -->
            <StackPanel Orientation="Horizontal" Spacing="15">
                <!-- Teal rune tile (macOS: ioSuccessGreen.opacity(0.10) bg, r14, ioSuccessGreen glow) -->
                <Border Width="54" Height="54" CornerRadius="14">
                    <Border.Background>
                        <SolidColorBrush Color="{StaticResource IoSuccessGreenColor}" Opacity="0.10" />
                    </Border.Background>
                    <TextBlock Text="&#x16A8;" FontFamily="{StaticResource IoFontDisplay}" FontSize="28"
                               Foreground="{StaticResource IoSuccessGreenBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.Name="Prophet rune" />
                </Border>

                <!-- Right column: eyebrow + title + lore subcaption + body paragraph -->
                <StackPanel Spacing="4" MaxWidth="560">
                    <TextBlock Text="THE SEER &#xB7; RESOLVER ACCURACY"
                               FontFamily="{StaticResource IoTypeEyebrow}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource IoSuccessGreenBrush}"
                               CharacterSpacing="260"
                               AutomationProperties.Name="The Seer, Resolver Accuracy" />
                    <TextBlock Text="Prophet"
                               FontFamily="{StaticResource IoFontDisplay}" FontSize="26"
                               Foreground="{StaticResource IoTextBrush}"
                               AutomationProperties.Name="Prophet" />
                    <!-- Subcaption. Parity with macOS ProphetView.swift:45-46: bodyAlternate
                         (Cormorant SC) at 17, owner copy, and NO wrapping quotation marks
                         (MEMORY.md:1795). The prior text carried a "begans" typo and a longer
                         ending, both superseded by the owner's 2026-08-02 revision. -->
                    <TextBlock Text="Thus the voyage began: The Prophet names each domain aright, so no false guise may be borne into view."
                               FontFamily="{StaticResource IoTypeBodyAlternate}" FontSize="17"
                               Foreground="{StaticResource IoTextMutedBrush}" TextWrapping="Wrap" />
                    <!-- Body paragraph beneath subcaption (owner copy). -->
                    <TextBlock Text="Prophet compares twelve resolver answers to queries sent for the domain you identify. A match only indicates consistency and does not mean the answers are valid. Resolver answers can be spoofed. Prophet then checks for DNSSEC on the domain, which does communicate trustworthiness."
                               FontFamily="{StaticResource IoTypeBody}" FontSize="13"
                               Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- 2. Domain selection card -->
            <Border CornerRadius="14" Padding="20"
                    BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="White" Opacity="0.03" />
                </Border.Background>
                <StackPanel Spacing="10">
                    <!-- Owner copy (verbatim), matching the macOS gold standard
                         (ProphetView.swift:71). No wrapping quotation marks (MEMORY.md:1795). -->
                    <TextBlock Text="In what domain do voices agree, their truth brought forth in dawn, and by the sacred seal, their truth preserved."
                               FontFamily="{StaticResource IoFontLore}" FontSize="18"
                               Foreground="{StaticResource IoTextMutedBrush}" TextWrapping="Wrap" />
                    <!-- Body text beneath the lore line (owner copy). -->
                    <TextBlock Text="Choose the domain you wish to check."
                               FontFamily="{StaticResource IoTypeBody}" FontSize="16"
                               Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />

                    <Grid ColumnSpacing="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Domain TextBox (macOS placeholder: "a domain to divine…"). -->
                        <TextBox Grid.Column="0" x:Name="DomainBox" PlaceholderText="a domain to divine&#x2026;"
                                 HorizontalAlignment="Stretch"
                                 FontFamily="{StaticResource IoFontMono}" FontSize="14"
                                 Foreground="{StaticResource IoTextBrush}"
                                 Background="{StaticResource IoBackgroundDarkBrush}"
                                 BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1"
                                 CornerRadius="10" Padding="12"
                                 TextChanged="DomainBox_TextChanged"
                                 AutomationProperties.Name="Domain to test"
                                 AutomationProperties.HelpText="Enter a domain name to query multiple DNS resolvers and check for consensus" />
                        <!-- E146: removed the decorative RecordTypePicker. The Kit does not support
                             record-type selection yet: ProbePlan.RunProphetAsync has no type parameter.
                             The picker had no binding, no handler, and every lookup was A/AAAA regardless.
                             Restoring it requires threading a type through ProbePlan -> DNSResolver first. -->
                        <TextBox Grid.Column="1" x:Name="ResolverBox" PlaceholderText="Resolver IP (optional)" Width="150"
                                 FontFamily="{StaticResource IoFontMono}" FontSize="13"
                                 Foreground="{StaticResource IoTextBrush}"
                                 Background="{StaticResource IoBackgroundDarkBrush}"
                                 BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1"
                                 CornerRadius="10" Padding="12"
                                 AutomationProperties.Name="Resolver IP (optional)"
                                 AutomationProperties.HelpText="Query a specific resolver by address instead of the system default. Leave blank to use the system resolver." />
                        <!-- "Divine the Domain" button (macOS: teal gradient, dark teal text). -->
                        <Button Grid.Column="2" x:Name="CheckBtn" Content="Divine the Domain"
                                Click="CheckBtn_Click"
                                Background="{StaticResource IoTealButtonBrush}"
                                Foreground="#FF062B26"
                                FontFamily="{StaticResource IoTypeUiLabel}" FontSize="14"
                                Padding="22,12,22,12"
                                CornerRadius="10"
                                IsEnabled="False"
                                AutomationProperties.Name="Divine the Domain"
                                AutomationProperties.HelpText="Queries multiple DNS resolvers for the domain and checks whether they agree on the result" />
                        <!-- Phase 9.5 loading indicator. INERT until ProphetView.xaml.cs wires it.
                             Nothing here claims a probe is running on its own, so a dead ring cannot
                             fake activity. -->
                        <ProgressRing Grid.Column="3" x:Name="CheckProgress" IsActive="False" Visibility="Collapsed"
                                      Width="18" Height="18" VerticalAlignment="Center"
                                      AutomationProperties.Name="Checking resolvers" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Resolver consensus result card (only when ProphetConsensusResult != null).
                 Background and border are set in code-behind from the consensus colour. -->
            <Border x:Name="ResolverCard" CornerRadius="14" Padding="20"
                    BorderThickness="1" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <!-- Coloured dot + two-run consensus headline. Parity macOS
                         ProphetView.swift:271-286: run 1 is Spectral Light 20 and run 2 Spectral
                         Light 17, BOTH in the state colour. Run 2 exists only for the lore
                         agree/disagree states; inconclusive and insufficient render run 1 alone
                         and never borrow either voice. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ConsensusDot" Width="9" Height="9"
                                 Fill="{StaticResource IoTextSecondaryBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="ConsensusHeadlinePrimary" Text=""
                                   FontFamily="{StaticResource IoTypeNavLabel}" FontSize="20"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource IoTextSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="ConsensusHeadlineSecondary" Text=""
                                   Visibility="Collapsed"
                                   FontFamily="{StaticResource IoTypeNavLabel}" FontSize="17"
                                   TextWrapping="Wrap" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Consensus detail (lore 14) -->
                    <TextBlock x:Name="ConsensusDetail" Text=""
                               FontFamily="{StaticResource IoFontLore}" FontSize="14"
                               Foreground="{StaticResource IoTextMutedBrush}" TextWrapping="Wrap" />

                    <!-- Scrollable resolver list (12 rows: resolver name left / IP right) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
                        <ListView x:Name="ResolverList"
                                  Background="Transparent" SelectionMode="None"
                                  ItemsSource="{x:Bind ResolverRows}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,9,0,9"
                                          BorderBrush="{StaticResource IoBorderSubtleBrush}"
                                          BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Resolver}"
                                                   FontFamily="{StaticResource IoTypeBody}" FontSize="15"
                                                   Foreground="#FF8F83B8" />
                                        <TextBlock Grid.Column="1" Text="{Binding Ip}"
                                                   FontFamily="{StaticResource IoFontMono}" FontSize="13"
                                                   Foreground="{StaticResource IoTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>

                    <!-- Consensus footer row (left label / right "N / N agree · Xms median") -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Consensus"
                                   FontFamily="{StaticResource IoTypeBody}" FontSize="15"
                                   Foreground="#FF8F83B8" />
                        <TextBlock Grid.Column="1" x:Name="AgreementFraction" Text=""
                                   FontFamily="{StaticResource IoFontMono}" FontSize="13"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. DNSSEC result card (only when DnssecStatus != null, rendered BELOW the resolver
                 card, NOT side-by-side). Duplicate of the resolver card structure, with a typed
                 status.description mono block and a "DNSSEC" footer row with a short status tag.
                 Background and border are set in code-behind from the DNSSEC colour. -->
            <Border x:Name="DnssecCard" CornerRadius="14" Padding="20"
                    BorderThickness="1" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <!-- Coloured dot + DNSSEC title -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse x:Name="DnssecDot" Width="9" Height="9"
                                 Fill="{StaticResource IoTextSecondaryBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="DnssecTitle" Text=""
                                   FontFamily="{StaticResource IoFontDisplay}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource IoTextSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <!-- DNSSEC detail (lore 14) -->
                    <TextBlock x:Name="DnssecDetail" Text=""
                               FontFamily="{StaticResource IoFontLore}" FontSize="14"
                               Foreground="{StaticResource IoTextMutedBrush}" TextWrapping="Wrap" />

                    <!-- DNSSEC posture body: the typed status description (mono 13), never a
                         fabricated "secure". Sourced from DNSSECVerifier.Describe(status). -->
                    <Border CornerRadius="10" Padding="12"
                            BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="White" Opacity="0.02" />
                        </Border.Background>
                        <TextBlock x:Name="DnssecDescription" Text=""
                                   FontFamily="{StaticResource IoFontMono}" FontSize="13"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                    </Border>

                    <!-- DNSSEC footer row (left label / right short status tag) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DNSSEC"
                                   FontFamily="{StaticResource IoTypeBody}" FontSize="15"
                                   Foreground="#FF8F83B8" />
                        <TextBlock Grid.Column="1" x:Name="DnssecStatusLabel" Text=""
                                   FontFamily="{StaticResource IoFontMono}" FontSize="13"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. Empty state (when ProphetConsensusResult == null).
                 Dashed-border placeholder with lore 15 text. -->
            <Grid x:Name="EmptyState" Visibility="Visible">
                <Rectangle Stroke="{StaticResource IoBorderSubtleBrush}" StrokeThickness="1"
                           StrokeDashArray="6,4" RadiusX="14" RadiusY="14" />
                <TextBlock x:Name="EmptyStateText" Text="The Prophet waits in silence. Name a city, and it shall divine."
                           FontFamily="{StaticResource IoFontLore}" FontSize="15"
                           Foreground="#FF7D7399"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Padding="34" TextWrapping="Wrap" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>