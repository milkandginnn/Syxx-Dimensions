    // MARK: - D003 collector TLS transport pinning

    /// A self-signed EC P-256 leaf whose reference pin was computed independently with:
    ///   openssl x509 -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64
    /// If the DER SubjectPublicKeyInfo walker drifts, this pin stops matching — catching a
    /// cross-platform parity break (the same value must be produced by .NET's ExportSubjectPublicKeyInfo).
    private static let d003CertDERBase64 =
        ""
    private static let d003ReferencePin = "FfEkilG5Q/bHox+eHUsh67GrlG2i/dtxUUDFWa4sQXY="

    func testCollectorSpkiPinMatchesReferencePin() {
        let der = Data(base64Encoded: Self.d003CertDERBase64)!
        let pin = CollectorPinning.spkiPin(forCertificateDER: der)
        XCTAssertEqual(pin, Self.d003ReferencePin,
                       "SPKI pin must equal the openssl/.NET reference (cross-platform parity).")
    }

    func testCollectorSpkiPinRejectsGarbage() {
        // Fail-closed: unparseable DER yields nil, which the delegate treats as a mismatch.
        XCTAssertNil(CollectorPinning.spkiPin(forCertificateDER: Data([0x30, 0x03, 0x02, 0x01, 0x00])))
        XCTAssertNil(CollectorPinning.spkiPin(forCertificateDER: Data()))
    }

    func testCollectorPinningDecisionIsFailClosed() {
        let good = Self.d003ReferencePin
        let other = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
        // PKI must pass first — an untrusted chain is refused regardless of pins.
        XCTAssertEqual(CollectorPinning.decide(trustPassed: false, leafPin: good, pins: [good]), .failed)
        // Unconfigured: standard validation only.
        XCTAssertEqual(CollectorPinning.decide(trustPassed: true, leafPin: good, pins: []), .notConfigured)
        // Configured + matching leaf -> enforced (proceeds).
        XCTAssertEqual(CollectorPinning.decide(trustPassed: true, leafPin: good, pins: [good, other]), .enforced)
        // Configured + NON-matching leaf -> failed (fail-closed). THE mutation guard: if pinning
        // were changed to accept-all, this would wrongly become .enforced.
        XCTAssertEqual(CollectorPinning.decide(trustPassed: true, leafPin: other, pins: [good]), .failed)
        // Configured but the leaf pin could not be computed -> failed, never accepted.
        XCTAssertEqual(CollectorPinning.decide(trustPassed: true, leafPin: nil, pins: [good]), .failed)
    }

    func testTransportIdentityFailureDetectsCancelled() {
        XCTAssertTrue(LeakDetector.isTransportIdentityFailure(URLError(.cancelled)))
        XCTAssertFalse(LeakDetector.isTransportIdentityFailure(URLError(.timedOut)))
        XCTAssertFalse(LeakDetector.isTransportIdentityFailure(URLError(.notConnectedToInternet)))
    }

    /// Load-bearing real run: a live TLS handshake against a local self-signed server with a
    /// configured pin that does NOT match must fail closed — the leak result is `.inconclusive`
    /// with `.failed` posture and the pinning reason, NOT a leak/no-leak result. Fails loudly
    /// if the local TLS server cannot be started (openssl must be installed via Homebrew).
    func testCollectorPinMismatchFailsClosedAgainstLiveTLS() async throws {
        let server = try LocalTLSServer.start()
        defer { server.stop() }
        let url = URL(string: "https://127.0.0.1:\(server.port)")!
        let result = await LeakDetector.runCollectorTest(
            servers: ["127.0.0.1"],
            collectorBaseURL: url,
            pollDelay: .milliseconds(1),
            pinSet: ["ThisPinDefinitelyDoesNotMatchTheServerLeaf00="]
        )
        XCTAssertTrue(result.result == .inconclusive || result.result == .error,
                       "A pin mismatch must never yield a trusted leak/no-leak result. Got: \(result.result)")
        XCTAssertEqual(result.transportPinning, .failed)
        XCTAssertEqual(result.errorReason, CollectorPinning.pinFailureReason)
        XCTAssertNil(result.signature, "No attestation may be accepted over an unverified transport.")
    }

