    func testWitnessSnapshotDomainWithDelimiterCharacterDoesNotCollide() throws {
        // Regression test using the structured JSON payload — domain with "|" cannot collide.
        let (priv, _) = testKeyPair
        let comparisonA = makeComparison(domain: "evil|{\"isRedirectionDetected\":true}")
        let comparisonB = makeComparison(domain: "evil")
        let snapshotA = try WitnessSigner.createSignedSnapshot(domain: "evil|{\"isRedirectionDetected\":true}", comparison: comparisonA, privateKeyBase64: priv)

        let crossedSnapshot = WitnessSnapshot(
            formatVersion: 2,
            timestamp: snapshotA.timestamp,
            expiresAt: nil,
            targetDomain: "evil",
            comparison: comparisonB,
            evidence: snapshotA.evidence,
            signature: snapshotA.signature,
            publicKey: snapshotA.publicKey,
            keyId: snapshotA.keyId
        )
        XCTAssertEqual(try WitnessSigner.verifySnapshot(crossedSnapshot), .displayMismatch)
    }

    func testWitnessKeyPairGeneration() throws {
        let (priv1, pub1) = WitnessSigner.generateKeyPair()
        let (priv2, pub2) = WitnessSigner.generateKeyPair()
        XCTAssertFalse(priv1.isEmpty)
        XCTAssertFalse(pub1.isEmpty)
        XCTAssertNotEqual(priv1, priv2)
        XCTAssertNotEqual(pub1, pub2)
        // Distinct non-empty strings don't prove a WORKING Ed25519 pair — a keygen returning distinct
        // garbage would pass the above. Prove it round-trips: a snapshot signed with priv1 verifies,
        // and the same snapshot with the OTHER pair's public key swapped in must NOT verify.
        let snap = try WitnessSigner.createSignedSnapshot(domain: "example.com", comparison: makeComparison(), privateKeyBase64: priv1)
        XCTAssertEqual(try WitnessSigner.verifySnapshot(snap), .valid, "a freshly generated pair must sign+verify")
        let wrongKey = WitnessSnapshot(
            formatVersion: snap.formatVersion, timestamp: snap.timestamp, expiresAt: nil,
            targetDomain: snap.targetDomain, comparison: snap.comparison, evidence: snap.evidence,
            signature: snap.signature, publicKey: pub2, keyId: snap.keyId)
        XCTAssertEqual(try WitnessSigner.verifySnapshot(wrongKey), .invalidSignature,
            "a snapshot verified under a DIFFERENT generated public key must be rejected")
    }

    func testWitnessThirdPartyVerification() throws {
        // Third party with only the public key can verify.
        let (priv, _) = testKeyPair
        let comparison = makeComparison()
        let snapshot = try WitnessSigner.createSignedSnapshot(domain: "example.com", comparison: comparison, privateKeyBase64: priv)
        XCTAssertEqual(try WitnessSigner.verifySnapshot(snapshot), .valid)

        // Someone who only knows the public key cannot forge a signature.
        let (attackerPriv, _) = testKeyPair
        let forged = try WitnessSigner.createSignedSnapshot(domain: "evil.com", comparison: comparison, privateKeyBase64: attackerPriv)
        let forgedSnapshot = WitnessSnapshot(
            formatVersion: 2,
            timestamp: forged.timestamp,
            expiresAt: nil,
            targetDomain: "evil.com",
            comparison: forged.comparison,
            evidence: forged.evidence,
            signature: forged.signature,
            publicKey: snapshot.publicKey,
            keyId: snapshot.keyId
        )
        XCTAssertEqual(try WitnessSigner.verifySnapshot(forgedSnapshot), .invalidSignature)
    }

