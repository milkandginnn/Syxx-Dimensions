    func testFingerprintIsSaltedHashNotRawIdentifier() {
        let fingerprint = LicenseManager.getSystemFingerprint()
        // A SHA-256 hex digest is 64 lowercase hex characters — not a raw UUID/hostname.
        XCTAssertEqual(fingerprint.count, 64)
        XCTAssertTrue(fingerprint.allSatisfy { $0.isHexDigit && !$0.isUppercase })
