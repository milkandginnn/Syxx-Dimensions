<Page
    x:Class="SyxxUI.Views.RemoteContentPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="{StaticResource IoBgBrush}">

    <Grid>
        <controls:WebView2 x:Name="ContentWebView"
                           NavigationStarting="OnNavigationStarting"
                           DefaultBackgroundColor="Transparent" />

        <Grid x:Name="OfflineOverlay"
              Visibility="Collapsed"
              Background="{StaticResource IoBgBrush}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="No Connection"
                           FontFamily="{StaticResource IoFontGrotesk}"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource IoTextBrush}" />
                <TextBlock Text="Syxx What's New could not be loaded.&#x0a;Please connect to the internet and try again."
                           FontFamily="{StaticResource IoFontGrotesk}"
                           FontSize="14"
                           Foreground="{StaticResource IoTextSecondaryBrush}"
                           TextWrapping="Wrap"
                           HorizontalTextAlignment="Center"
                           MaxWidth="320" />
            </StackPanel>
        </Grid>

        <ProgressRing x:Name="LoadingRing"
                      IsActive="True"
                      Width="32" Height="32"
                      Foreground="{StaticResource IoBlueBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
