    // MARK: - DNSSEC temporal parsing (M42-M46)

    /// Builds an RRSIG rdata hex string with the given inception/expiration epoch seconds.
    private func rrsigHex(inception: UInt32, expiration: UInt32) -> String {
        var bytes: [UInt8] = [0x00, 0x30, 0x08, 0x02] // typeCovered=48 (DNSKEY), alg=8, labels=2
        bytes.append(contentsOf: [0x00, 0x00, 0x01, 0x2C]) // originalTTL=300
        bytes.append(contentsOf: [UInt8(expiration >> 24), UInt8((expiration >> 16) & 0xff), UInt8((expiration >> 8) & 0xff), UInt8(expiration & 0xff)])
        bytes.append(contentsOf: [UInt8(inception >> 24), UInt8((inception >> 16) & 0xff), UInt8((inception >> 8) & 0xff), UInt8(inception & 0xff)])
        bytes.append(contentsOf: [0x12, 0x34]) // keyTag
        bytes.append(0x00) // signer name (root) — enough to exceed the 18-byte minimum
        return bytes.map { String(format: "%02x", $0) }.joined()
    }

    func testRRSIGValidityWindowParsesInceptionAndExpiration() {
        // A042: raw 32-bit seconds are surfaced (for serial-number arithmetic), not absolute Dates.
        let hex = rrsigHex(inception: 1_000_000, expiration: 2_000_000)
        let window = DNSSECVerifier.rrsigValidityWindow(rdataHex: hex, expectedTypeCovered: 48)
        XCTAssertNotNil(window)
        XCTAssertEqual(window?.inception, 1_000_000)
        XCTAssertEqual(window?.expiration, 2_000_000)
    }

    func testRRSIGValidityWindowRejectsShortRdata() {
        XCTAssertNil(DNSSECVerifier.rrsigValidityWindow(rdataHex: "0001080200", expectedTypeCovered: 48))
        XCTAssertNil(DNSSECVerifier.rrsigValidityWindow(rdataHex: "zznothex", expectedTypeCovered: 48))
    }

    func testRRSIGValidityWindowRejectsWrongTypeCovered() {
        // KDNS-05: an RRSIG covering a non-DNSKEY RRset (typeCovered != 48) must not be accepted as
        // proof the DNSKEY set is signed.
        let hex = rrsigHex(inception: 1_000_000, expiration: 2_000_000) // typeCovered = 48
        XCTAssertNil(DNSSECVerifier.rrsigValidityWindow(rdataHex: hex, expectedTypeCovered: 1))
    }

    // MARK: - A042 RFC 1982 serial-number arithmetic + B047 clock-spoof guard

    func testRRSIGWindowValidWhenNowInsideWindow() {
        let now = Date(timeIntervalSince1970: 1_500_000)
        XCTAssertTrue(DNSSECVerifier.rrsigWindowCurrentlyValid(inception: 1_000_000, expiration: 2_000_000, now: now))
    }

    func testRRSIGWindowExpiredWhenNowAfterExpiration() {
        let now = Date(timeIntervalSince1970: 2_500_000)
        XCTAssertFalse(DNSSECVerifier.rrsigWindowCurrentlyValid(inception: 1_000_000, expiration: 2_000_000, now: now))
    }

    func testRRSIGWindowNotYetValidWhenNowBeforeInception() {
        let now = Date(timeIntervalSince1970: 500_000)
        XCTAssertFalse(DNSSECVerifier.rrsigWindowCurrentlyValid(inception: 1_000_000, expiration: 2_000_000, now: now))
    }

    func testRRSIGWindowSerialWrapAroundIsValid() {
        // A042: a window that straddles the 2106 (2^32) epoch wrap. inception is 100s before the wrap,
        // expiration is 100s after it, now is 10s after the wrap. Under RFC 1982 serial arithmetic this
        // is INSIDE the window; a naive absolute-epoch comparison (now < inception) would wrongly call
        // it not-yet-valid.
        let wrap: UInt32 = UInt32.max // 2^32 - 1
        let inception = wrap &- 100
        let expiration: UInt32 = 100          // 101 seconds after the wrap point
        let nowEpoch: UInt32 = 10             // 11 seconds after the wrap point
        XCTAssertTrue(DNSSECVerifier.serialLessThanOrEqual(inception, nowEpoch))
        XCTAssertTrue(DNSSECVerifier.serialLessThanOrEqual(nowEpoch, expiration))
        let now = Date(timeIntervalSince1970: TimeInterval(UInt64(UInt32.max) + 1 + UInt64(nowEpoch)))
        XCTAssertTrue(DNSSECVerifier.rrsigWindowCurrentlyValid(inception: inception, expiration: expiration, now: now))
    }

    func testRRSIGWindowRejectsImplausiblySpanned() {
        // B047: an attacker who spoofs the local clock forward could try to wrap a long-expired
        // signature back into "valid". A validity span wider than our sane bound (2 years) is refused
        // even when `now` sits between the endpoints under serial arithmetic.
        let inception: UInt32 = 1_000_000
        let expiration: UInt32 = inception &+ DNSSECVerifier.maxPlausibleValiditySpanSeconds &+ 1
        let now = Date(timeIntervalSince1970: TimeInterval(inception) + 10)
        XCTAssertFalse(DNSSECVerifier.rrsigWindowCurrentlyValid(inception: inception, expiration: expiration, now: now))
    }

    func testRRSIGWindowRejectsExpirationBeforeInception() {
        // A malformed window whose expiration precedes its inception (serial) is never "valid".
        let now = Date(timeIntervalSince1970: 1_500_000)
        XCTAssertFalse(DNSSECVerifier.rrsigWindowCurrentlyValid(inception: 2_000_000, expiration: 1_000_000, now: now))
    }

    // MARK: - Classifier honesty (A030 / A036 / B046)

    private func dnskeyRecord() -> DNSRecord {
        DNSRecord(name: "example.", type: 48, ttl: 3600, rdata: "0101030dabcdef")
    }
    private func rrsigDnskeyRecord(inception: UInt32, expiration: UInt32) -> DNSRecord {
        DNSRecord(name: "example.", type: 46, ttl: 3600, rdata: rrsigHex(inception: inception, expiration: expiration))
    }

    func testClassifyNoDNSKEYIsUnsigned() {
