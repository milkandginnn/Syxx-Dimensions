    func testParseResponsePacketDetailedMapsRCodes() {
        func packetWithRCode(_ rcode: UInt16) -> Data {
            var bytes: [UInt8] = [0x12, 0x34]
            let flags: UInt16 = 0x8000 | rcode // QR=1, no other flags, given RCODE
            bytes.append(UInt8(flags >> 8))
            bytes.append(UInt8(flags & 0xff))
            bytes.append(contentsOf: [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00])
            return Data(bytes)
        }
        XCTAssertEqual(DNSResolver.parseResponsePacketDetailed(packetWithRCode(2)).status, .servFail)
        XCTAssertEqual(DNSResolver.parseResponsePacketDetailed(packetWithRCode(3)).status, .nxDomain)
        XCTAssertEqual(DNSResolver.parseResponsePacketDetailed(packetWithRCode(5)).status, .refused)
    }

    func testParseResponsePacketDetailedRejectsQueryQR0() {
        var packet: [UInt8] = [0x12, 0x34]
        packet.append(contentsOf: [0x01, 0x00]) // QR=0 (Query)
        packet.append(contentsOf: [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00])

        let response = DNSResolver.parseResponsePacketDetailed(Data(packet))
        XCTAssertEqual(response.status, .malformedResponse)
        XCTAssertEqual(response.errorMessage, "Not a response packet (QR bit is 0)")
    }

