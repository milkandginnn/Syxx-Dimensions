    // MARK: - VantageComparer inconclusive/degraded evaluation (P3)

    private func outcome(records: [DNSRecord] = [], status: DNSResponseStatus = .success) -> ResolverQueryOutcome {
        ResolverQueryOutcome(records: records, status: status)
    }

    private let sampleRecord = DNSRecord(name: "example.com", type: 1, ttl: 60, rdata: "93.184.216.34")

    func testEvaluateIsInconclusiveWhenAllPublicResolversFail() {
        let local = outcome(records: [sampleRecord])
        let publics: [String: ResolverQueryOutcome] = [
            "A": outcome(status: .timeout),
            "B": outcome(status: .transportError),
            "C": outcome(status: .timeout)
        ]
        let result = VantageComparer.evaluate(localOutcome: local, publicOutcomes: publics)
        XCTAssertTrue(result.inconclusive)
        XCTAssertFalse(result.redirection)
    }

    func testEvaluateIsInconclusiveWhenLocalQueryFails() {
        let local = outcome(status: .timeout)
        let publics: [String: ResolverQueryOutcome] = ["A": outcome(records: [sampleRecord])]
        let result = VantageComparer.evaluate(localOutcome: local, publicOutcomes: publics)
        XCTAssertTrue(result.inconclusive)
    }

    func testEvaluateAllowsCDNStyleDivergenceWithoutFlaggingRedirection() {
        // Local and public resolvers return different (but both legitimate/public) IPs — this
        // is normal CDN/geo-DNS behavior, not tampering, as long as there's some overlap-worthy
        // baseline. Here local matches one of the two public answers, so it should not flag.
        let local = outcome(records: [DNSRecord(name: "cdn.example.com", type: 1, ttl: 60, rdata: "1.2.3.4")])
        let publics: [String: ResolverQueryOutcome] = [
            "A": outcome(records: [DNSRecord(name: "cdn.example.com", type: 1, ttl: 60, rdata: "1.2.3.4")]),
            "B": outcome(records: [DNSRecord(name: "cdn.example.com", type: 1, ttl: 60, rdata: "5.6.7.8")])
        ]
        let result = VantageComparer.evaluate(localOutcome: local, publicOutcomes: publics)
        XCTAssertFalse(result.inconclusive)
        XCTAssertFalse(result.redirection)
    }

    func testEvaluateFlagsRedirectionWhenLocalAnswerIsDisjointFromConsensus() {
        let local = outcome(records: [DNSRecord(name: "example.com", type: 1, ttl: 60, rdata: "10.10.10.10")])
        let publics: [String: ResolverQueryOutcome] = [
            "A": outcome(records: [sampleRecord]),
            "B": outcome(records: [sampleRecord])
        ]
        let result = VantageComparer.evaluate(localOutcome: local, publicOutcomes: publics)
        XCTAssertFalse(result.inconclusive)
        XCTAssertTrue(result.redirection)
    }

    func testEvaluateEmptyButSuccessfulLocalIsInconclusiveNotRedirection() {
        // B017 regression: a local resolver that SUCCEEDS but returns no records (NODATA/NXDOMAIN)
        // while public resolvers return records is NOT tampering — split-horizon/geo/no-such-record
        // all produce it. This must read as inconclusive, never a fabricated redirection. (Distinct
        // from a transport failure, which is already inconclusive via didFail.)
        let local = outcome(records: [], status: .success)
        let publics: [String: ResolverQueryOutcome] = [
            "A": outcome(records: [sampleRecord]),
            "B": outcome(records: [sampleRecord])
        ]
        let result = VantageComparer.evaluate(localOutcome: local, publicOutcomes: publics)
        XCTAssertFalse(result.redirection, "empty-successful local must not be called redirection (B017)")
        XCTAssertTrue(result.inconclusive)
    }

    func testEvaluateFlagsRedirectionWhenLocalReturnsBlockingAnswer() {
        let local = outcome(records: [DNSRecord(name: "example.com", type: 1, ttl: 60, rdata: "127.0.0.1")])
        let publics: [String: ResolverQueryOutcome] = [
            "A": outcome(records: [sampleRecord]),
            "B": outcome(records: [sampleRecord])
        ]
        let result = VantageComparer.evaluate(localOutcome: local, publicOutcomes: publics)
        XCTAssertTrue(result.redirection)
    }

    func testEvaluateMarksDegradedWhenOnePublicResolverFailsButOthersSucceed() {
        let local = outcome(records: [sampleRecord])
        let publics: [String: ResolverQueryOutcome] = [
            "A": outcome(records: [sampleRecord]),
            "B": outcome(status: .timeout)
        ]
        let result = VantageComparer.evaluate(localOutcome: local, publicOutcomes: publics)
        XCTAssertFalse(result.inconclusive)
        XCTAssertFalse(result.redirection)
        XCTAssertTrue(result.degraded)
    }

    func testEvaluateSingleBaselineIsDegradedNotRedirection() {
        // Min-2-vantage guard: with only one usable public baseline there is no consensus to
        // compare against, so even a fully disjoint local answer must read as degraded — not a
        // redirection result built on a single witness.
        let local = outcome(records: [DNSRecord(name: "example.com", type: 1, ttl: 60, rdata: "10.10.10.10")])
        let publics: [String: ResolverQueryOutcome] = ["A": outcome(records: [sampleRecord])]
        let result = VantageComparer.evaluate(localOutcome: local, publicOutcomes: publics)
        XCTAssertFalse(result.redirection)
        XCTAssertFalse(result.inconclusive)
        XCTAssertTrue(result.degraded)
    }

