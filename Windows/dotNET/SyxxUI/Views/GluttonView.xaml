<Page
    x:Class="SyxxUI.Views.GluttonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SyxxUI.Views"
    Background="Transparent">

    <ScrollViewer>
    <Grid Padding="32,18,32,32">
        <StackPanel Spacing="24">

            <!-- Header: eyebrow + ornate line + Check button (parity with macOS GluttonView). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="GLUTTON • DNS LEAK &amp; ENCRYPTION"
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource IoBlueBrush}" />
                    <TextBlock Text="Alas, the Glutton hungered for encrypted packets and demanded that any leak in the sealed DNS traffic be found and named, for a single crack was enough to render him famished."
                               FontFamily="{StaticResource IoFontLore}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource IoTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="CheckBtn" Content="Check for Leaks"
                        VerticalAlignment="Bottom" Margin="16,0,0,0"
                        Click="CheckBtn_Click"
                        Background="{StaticResource IoBlueBrush}"
                        Foreground="{StaticResource IoTextBrush}"
                        AutomationProperties.Name="Check for DNS leaks"
                        AutomationProperties.HelpText="Probes whether unencrypted DNS queries leak outside your VPN tunnel" />
            </Grid>

            <!-- Plain-language description (macOS full text). -->
            <TextBlock Text="Glutton probes whether unencrypted DNS queries leak outside encrypted VPN tunnels (syxx leak), catching when queries bypass configured tunnels and making them visible. This test is only meaningful if you're connected to the internet via a VPN or using DNS encryption profile. It will be skipped if no VPN or DNS encryption is detected."
                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                       Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />

            <!-- Status cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource IoSurfaceDarkBrush}"
                        CornerRadius="12" Padding="18"
                        BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="FEATURE STATUS:"
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="FeatureStatusIcon" Text="✗"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource IoCriticalRedBrush}" />
                            <TextBlock x:Name="FeatureStatusText" Text="Loading…"
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource IoCriticalRedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource IoSurfaceDarkBrush}"
                        CornerRadius="12" Padding="18"
                        BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="VPN / DNS ENCRYPTION STATUS:"
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" />
                        <TextBlock x:Name="VpnEmptyText" Text="Run Portal first or check the CLI for VPN status."
                                   FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel x:Name="VpnContent" Spacing="8" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse x:Name="VpnDot" Width="8" Height="8"
                                         Fill="{StaticResource IoTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="VpnStatusText" Text="—"
                                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="VpnDetailText" Text=""
                                       FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                       Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Probe results -->
            <StackPanel Spacing="10">
                <TextBlock Text="TEST LABEL:"
                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource IoTextSecondaryBrush}" />
                <TextBlock x:Name="SubdomainText" Text="Run a leak check to generate a probe subdomain."
                           FontFamily="{StaticResource IoFontMono}" FontSize="14"
                           Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="NoProbesText" Text="No probes dispatched."
                           FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                           Foreground="{StaticResource IoTextSecondaryBrush}" Visibility="Collapsed" />
                <ListView x:Name="ProbesList" Background="Transparent" SelectionMode="None"
                          ItemsSource="{x:Bind ProbeRows}"
                          AutomationProperties.Name="DNS probe results"
                          AutomationProperties.HelpText="Shows which DNS resolvers received your leak probes and whether they were sent successfully">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:GluttonProbeRow">
                            <Border Background="{StaticResource IoBackgroundDarkBrush}"
                                    CornerRadius="8" Padding="12,10"
                                    BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Probe via"
                                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12"
                                               Foreground="{StaticResource IoTextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Server}" Margin="12,0"
                                               FontFamily="{StaticResource IoFontMono}" FontSize="13"
                                               Foreground="{StaticResource IoTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind SentLabel}"
                                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                                               Foreground="{x:Bind SentBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Collector verification. D044/D004: the conclusion is rendered from the REAL LeakTestResult
                 and honesty-gated on the signed attestation — never a hardcoded pass. -->
            <Border Background="{StaticResource IoSurfaceDarkBrush}" CornerRadius="12" Padding="18"
                    BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="COLLECTOR VERIFICATION:"
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource IoTextSecondaryBrush}" />
                    <TextBlock Text="A leak collector confirms which upstream resolver actually forwarded your probes. The collector produces a signed attestation usable as evidence."
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="14"
                               Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="LeakResultText" Text="No leak check has run yet."
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="LeakResultDetailText"
                               Text="Run a leak check; the collector's signed attestation decides the conclusion shown here."
                               FontFamily="{StaticResource IoFontGrotesk}" FontSize="13"
                               Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                    <Border Background="{StaticResource IoBackgroundDarkBrush}"
                            CornerRadius="8" Padding="12"
                            BorderBrush="{StaticResource IoBorderSubtleBrush}" BorderThickness="1">
                        <TextBlock Text="&gt; syxx leak --collector https://syxx.app --key &lt;license-key&gt;   (CLI equivalent)"
                                   FontFamily="{StaticResource IoFontMono}" FontSize="12"
                                   Foreground="{StaticResource IoTextSecondaryBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
